<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<title>Commercial Invoice</title>

<style>
*{
  box-sizing:border-box;
}

body{
  font-family: Arial, Helvetica, sans-serif;
  font-size:11px;
  color:#000;
  margin:0;
  padding:14px;
}

table{
  width:100%;
  border-collapse:collapse;
}

td, th{
  border:1px solid #000;
  padding:4px 6px;
  vertical-align:top;
}

.center{ text-align:center; }
.right{ text-align:right; }
.bold{ font-weight:bold; }

.small{ font-size:10px; }
.tiny{ font-size:9px; }

.no-border td{
  border:none;
}

.section-gap{
  margin-top:6px;
}

.wrap{
  white-space:pre-line;
}

.footer-note{
  font-size:10px;
  text-align:center;
  padding:4px;
}

.items-table td,
.items-table th{
  font-size:10px;
}

.signature-box{
  height:90px;
}

.line-space{
  line-height:1.45;
}
</style>
</head>

<body>

<!-- TITLE -->
<!-- TITLE -->
<table>
<tr>
<td class="center bold" style="font-size:16px;">
COMMERCIAL INVOICE
</td>
</tr>
</table>

<!-- TOP MASTER BLOCK -->
<table style="margin-top:-1px; table-layout:fixed; height:320px;">
<tr>

<!-- LEFT SIDE -->
<td style="width:39%; padding:0;">

<table style="width:100%; height:100%; border:none; table-layout:fixed;">

<tr style="height:26%;">
<td style="border:none; border-bottom:1px solid #000; line-height:1.45;">

<div class="bold" style="font-size:13px;">{{exporter.name}}</div>

{{exporter.address.houseBuilding}}<br>
{{exporter.address.streetArea}}<br>
{{exporter.address.cityTown}} - {{exporter.address.pincode}}<br>
{{exporter.address.state}}, {{exporter.address.country}}<br>
GSTIN/UIN: {{exporter.gstNumber}}<br>
State Name : {{exporter.address.state}}, Code : {{exporter.address.pincode}}

</td>
</tr>

<tr style="height:37%;">
<td style="border:none; border-bottom:1px solid #000; line-height:1.45;">

<div style="margin-bottom:3px;">Consignee (Ship to)</div>

<div class="bold" style="font-size:13px;">
{{buyer.companyName}}
</div>

{{#if buyer.address.houseBuilding}}{{buyer.address.houseBuilding}}<br>{{/if}}
{{#if buyer.address.streetArea}}{{buyer.address.streetArea}}<br>{{/if}}
{{buyer.address.cityTown}}<br>
{{buyer.address.country}}

</td>
</tr>

<tr style="height:37%;">
<td style="border:none; line-height:1.45;">

<div style="margin-bottom:3px;">Buyer (Bill to)</div>

<div class="bold" style="font-size:13px;">
{{buyer.companyName}}
</div>

{{#if buyer.address.houseBuilding}}{{buyer.address.houseBuilding}}<br>{{/if}}
{{#if buyer.address.streetArea}}{{buyer.address.streetArea}}<br>{{/if}}
{{buyer.address.cityTown}}<br>
{{buyer.address.country}}

</td>
</tr>

</table>

</td>

<!-- RIGHT SIDE -->
<td style="width:61%; padding:0;">

<table style="width:100%; border:none; table-layout:fixed;">

<!-- LABELS -->
<tr>
<td style="width:47%; border-top:none; border-left:none;">
<div>INVOICE NO</div>
<div class="bold" style="margin-top:4px;">{{invoiceNo}}</div>
</td>

<td style="border-top:none; border-right:none;">
<div>Dated</div>
<div class="bold" style="margin-top:4px;">{{invoiceDate}}</div>
</td>
</tr>

<!-- MODE -->
<tr>
<td style="border-left:none;"></td>

<td style="border-right:none;">
<div>Mode/Terms of Payment</div>
<div class="bold" style="margin-top:4px;">
LC NO :-{{otherReference}} Dt {{piDate}}
</div>
</td>
</tr>

<!-- BUYER REF -->
<tr>
<td style="border-left:none; height:38px; vertical-align:top;">
Buyer's Ref./Order No.
</td>

<td style="border-right:none; height:38px; vertical-align:top;">
Other References
</td>
</tr>

<!-- DISPATCH -->
<tr>
<td style="border-left:none; height:38px; vertical-align:top;">
Dispatched through
</td>

<td style="border-right:none; height:38px; vertical-align:top;">
Destination
</td>
</tr>

<!-- COUNTRY -->
<tr>
<td colspan="2" style="border-left:none; border-right:none;">
Country:&nbsp;&nbsp;<span class="bold">{{countryDestination}}</span>
</td>
</tr>

<!-- TERMS -->
<tr>
<td colspan="2" style="border-left:none; border-right:none; border-bottom:none; vertical-align:top; line-height:1.55;">

<div style="margin-bottom:4px;">Terms of Delivery</div>

1)&nbsp;&nbsp;Delivery Term: {{termsOfDelivery}}<br>
2)&nbsp;&nbsp;Port of Loading: {{portOfLoading}}<br>
3)&nbsp;&nbsp;Port of Discharge: {{portOfDischarge}}

</td>
</tr>

</table>

</td>

</tr>
</table>


<!-- ITEMS TABLE -->
<table class="items-table" style="margin-top:-1px;">

<thead>
<tr class="center bold">
<th style="width:6%;">Sl<br>No.</th>
<th style="width:44%;">Description of Goods</th>
<th style="width:12%;">HSN/SAC</th>
<th style="width:10%;">FOB</th>
<th style="width:10%;">FREIGHT</th>
<th style="width:6%;">per</th>
<th style="width:12%;">Amount</th>
</tr>
</thead>

<tbody>

{{#each items}}
<tr>
<td class="center">{{sr}}</td>

<td class="line-space">

<div class="bold">01 UNIT OF USED {{model}}</div>

CHASSIS NO : {{chassisNo}}<br>
ENGINE NO : {{engineNo}}<br>
YEAR OF MANUFACTURE : {{year}}<br>
MONTH/YEAR OF FIRST REGISTRATION : {{registrationDate}}<br>
MAKE : {{make}}<br>
MODEL : {{model}}<br>
TYPE OF VEHICLE : {{vehicleType}}<br>
COUNTRY OF ORIGIN : {{countryOrigin}}<br>
EXPORT INSPECTION CERTIFICATE NO : {{inspectionNo}}<br>
EXPORT INSPECTION CERTIFICATE DATE : {{inspectionDate}}

</td>

<td class="center">{{hsn}}</td>
<td class="right">{{fob}}</td>
<td class="right">{{freight}}</td>
<td class="center">{{per}}</td>
<td class="right">{{amount}}</td>
</tr>
{{/each}}

<tr>
<td colspan="6" class="right bold">TOTAL</td>
<td class="right bold">{{grandTotal}}</td>
</tr>

</tbody>
</table>

<!-- DECLARATION -->
<table style="margin-top:-1px;">
<tr>
<td>

<div class="bold">DECLARATION:</div>

<div class="line-space small">

1. We hereby certify that the goods are of Indian Origin.<br>
2. Vehicle supplied in sound condition with standard accessories.<br>
3. Country of Origin : INDIA.<br>
4. This invoice shows actual transaction value of supplied goods.<br>
5. All particulars declared above are true and correct.<br>

</div>

</td>
</tr>
</table>

<!-- AMOUNT WORDS -->
<table style="margin-top:-1px;">
<tr>
<td>
<div class="bold">Amount Chargeable (In Words)</div>
USD {{amountWords}}
</td>
</tr>
</table>

<!-- SIGNATURE -->
<table style="margin-top:-1px;">
<tr>

<td style="width:60%; border-right:none;">
</td>

<td style="width:40%;" class="signature-box">

<div class="right bold" style="margin-top:55px;">
for {{exporter.name}}
</div>

<div style="border-top:1px solid #000; margin-top:22px;"></div>

<div class="right">
Authorised Signatory
</div>

</td>

</tr>
</table>

<!-- FOOTER -->
<table style="margin-top:-1px;">
<tr>
<td class="footer-note">
This is a Computer Generated Document
</td>
</tr>
</table>

</body>
</html>