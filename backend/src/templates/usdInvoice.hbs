<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>USD Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 10mm 12mm; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.7px; line-height: 1.06; color: #000; margin: 0; }
    * { box-sizing: border-box; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { border: 0.5px solid #000; padding: 1.6px 2.4px; vertical-align: top; }
    .title { font-size: 8.7px; font-weight: 700; text-align: center; }
    .right { text-align: right; }
    .center { text-align: center; }
    .tiny { font-size: 6.9px; }
    .min { font-size: 6.6px; }
    .desc div { margin-bottom: 1.6px; }
    .bank-grid td { height: 16px; }
    .no-break { break-inside: avoid; page-break-inside: avoid; }
  </style>
</head>
<body>
  <table>
    <colgroup>
      <col style="width:15.5%">
      <col style="width:12%">
      <col style="width:24%">
      <col style="width:11%">
      <col style="width:12%">
      <col style="width:12%">
      <col style="width:6.5%">
      <col style="width:7%">
    </colgroup>
    <tr>
      <td colspan="8" class="title">INVOICE <span style="float:right;">Page - I</span></td>
    </tr>
    <tr>
      <td colspan="4" rowspan="5">
        <div>Exporter</div>
        <div>{{exporter.companyName}}</div>
        {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
        <div>{{exporter.stateCode}}</div>
        <div>Maharashtra, India.</div>
        <div>GST NO- {{exporter.gstin}}</div>
      </td>
      <td colspan="4">Invoice No &amp; Dt. <span style="float:right;">{{invoiceNumber}} Dt.{{invoiceDate}}</span></td>
    </tr>
    <tr>
      <td colspan="2">Buyers Order &amp; Dt</td>
      <td colspan="2">{{buyerOrderDate}}</td>
    </tr>
    <tr>
      <td colspan="2">Other Reference</td>
      <td colspan="2">PI No - {{piNumber}} Dt {{piDate}}</td>
    </tr>
    <tr>
      <td colspan="2"></td>
      <td colspan="2">LC NO - {{lcNumber}} DT {{lcDate}}</td>
    </tr>
    <tr>
      <td colspan="4"></td>
    </tr>

    <tr>
      <td colspan="4" rowspan="6">
        <div>Consignee</div>
        <div>{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
      </td>
      <td colspan="4">DRAWBACK SHIPMENT</td>
    </tr>
    <tr>
      <td colspan="4">RODTEP SCHEME CODE {{scheme.rodtepSchemeCode}}</td>
    </tr>
    <tr>
      <td colspan="4">END USE CODE- {{scheme.endUseCode}}</td>
    </tr>
    <tr>
      <td colspan="4">IGST PAYMENT STATUS- YES</td>
    </tr>
    <tr>
      <td colspan="4">SHIPMENT EXPORT UNDER IGST PAID</td>
    </tr>
    <tr>
      <td colspan="2">IEC NO- {{exporter.iecNo}}</td>
      <td colspan="2">AD CODE - {{exporter.adCode}}</td>
    </tr>

    <tr>
      <td>Pre -<br />Carriage</td>
      <td>{{preCarriage}}</td>
      <td>Place of Rcpt by Pre Carrier</td>
      <td>{{placeOfReceipt}}</td>
      <td>Country of Origin</td>
      <td>INDIA</td>
      <td>Country of Destination</td>
      <td>{{buyerCountry}}</td>
    </tr>
    <tr>
      <td>Vessel/<br />Flight</td>
      <td>{{vesselFlight}}</td>
      <td>Port of Loading</td>
      <td>{{portOfLoading}}</td>
      <td colspan="4">Terms of Delivery and Payment</td>
    </tr>
    <tr>
      <td>Port of Discharge</td>
      <td>{{portOfDischarge}}</td>
      <td>Place of Delivery</td>
      <td>{{placeOfDelivery}}</td>
      <td colspan="4">{{scheme.termsOfPayment}}</td>
    </tr>
    <tr>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td colspan="4">State of Origin of Goods - {{stateOfOrigin}}</td>
    </tr>
    <tr>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td colspan="4">District of Origin of Goods - {{districtOfOrigin}}</td>
    </tr>

    <tr>
      <td class="center">Marks &amp; Nos<br />Container No</td>
      <td class="center">No &amp; Kind<br />of Pkgs</td>
      <td class="center">Description of Goods</td>
      <td class="center">Quantity<br />In Nos</td>
      <td class="center">Rate<br />DDU<br />BY SEA</td>
      <td class="center">Amount<br />In USD</td>
      <td colspan="2" class="center">RMKS<br />(IF ANY)</td>
    </tr>

    <tr class="no-break">
      <td rowspan="8">{{containerNo}}<br /><br />{{placeOfDelivery}}</td>
      <td rowspan="8" class="center">Sr no<br /><br />1</td>
      <td rowspan="8" class="desc">
        {{#each descriptionLines}}<div>{{this}}</div>{{/each}}
      </td>
      <td rowspan="8" class="center">{{totalQty}}<br /><br />Pcs</td>
      <td rowspan="8" class="right">${{values.totalUSD}}</td>
      <td rowspan="8" class="right">${{values.totalUSD}}</td>
      <td colspan="2" rowspan="8"></td>
    </tr>
    <tr></tr>
    <tr></tr>
    <tr></tr>
    <tr></tr>
    <tr></tr>
    <tr></tr>
    <tr></tr>

    <tr>
      <td colspan="2" class="center">Total No of Cartons</td>
      <td colspan="2" class="center">Amount Chargeable (In Words)</td>
      <td colspan="2" class="center">Total</td>
      <td colspan="2" class="right">${{values.totalUSD}}</td>
    </tr>
    <tr>
      <td colspan="2" class="center">Nos</td>
      <td colspan="4">{{amountWordsUSD}}</td>
      <td colspan="2"></td>
    </tr>
    <tr>
      <td colspan="2" class="center">Total Net.Wt.</td>
      <td colspan="4" rowspan="6">
        <div>Declaration</div>
        <div class="min">DBK001- "{{staticText.DBK001}}"</div>
        <div class="min">DBK003- "{{staticText.DBK003}}"</div>
        <div class="min">{{staticText.DECLARATION}}</div>
        <div class="min">We intend to claim rewards under Merchandise Exports From India Scheme (MEIS)</div>
        <div class="min">RoDTEP Scheme</div>
        <div class="min">STATEMENT ON ORIGIN</div>
        <div class="min">{{staticText.GSP_ORIGIN}}</div>
      </td>
      <td colspan="2" class="center">Sign &amp; Date</td>
    </tr>
    <tr>
      <td colspan="2" class="center">K.G.</td>
      <td colspan="2" rowspan="5"></td>
    </tr>
    <tr>
      <td colspan="2" class="center">Total Gross.Wt.</td>
    </tr>
    <tr>
      <td colspan="2" class="center">K.G.</td>
    </tr>
    <tr>
      <td colspan="2" rowspan="2"></td>
    </tr>
    <tr></tr>

    <tr class="bank-grid">
      <td colspan="4"></td>
      <td colspan="2">BANK DETAILS</td>
      <td colspan="2">NAME - {{exporter.bankName}}</td>
    </tr>
    <tr class="bank-grid">
      <td colspan="4"></td>
      <td colspan="2"></td>
      <td colspan="2">ACCOUNT NO - {{exporter.accountNo}}</td>
    </tr>
    <tr class="bank-grid">
      <td colspan="4"></td>
      <td colspan="2"></td>
      <td colspan="2">IFSC Code -{{exporter.ifsc}}</td>
    </tr>
    <tr class="bank-grid">
      <td colspan="4"></td>
      <td colspan="2"></td>
      <td colspan="2">SWIFT code: {{exporter.swift}}</td>
    </tr>
  </table>
</body>
</html>
