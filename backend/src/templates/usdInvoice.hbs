<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Commercial Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 8mm 8mm; }
    html, body { margin: 0; padding: 0; background: #fff; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.5px; color: #000; line-height: 1.15; }
    * { box-sizing: border-box; }

    table.main {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      border: 0.5px solid #000;
    }
    table.main td {
      border: 0.5px solid #000;
      padding: 1.5px 3px;
      vertical-align: top;
      word-break: break-word;
    }

    /* 8 Columns Grid */
    col.c1 { width: 14%; }
    col.c2 { width: 8%; }
    col.c3 { width: 28%; }
    col.c4 { width: 8%; }
    col.c5 { width: 8%; }
    col.c6 { width: 11%; }
    col.c7 { width: 11%; }
    col.c8 { width: 12%; }

    .b { font-weight: bold; }
    .c { text-align: center; }
    .r { text-align: right; }
    .l { text-align: left; }
    .title { text-align: center; font-size: 10px; font-weight: bold; padding: 3px; border-bottom: 0.5px solid #000; }
    
    .sh-l { font-size: 7px; font-weight: bold; border-bottom: none !important; height: 18px; }
    .sh-v { font-size: 7.5px; border-top: none !important; height: 18px; text-align: center; vertical-align: middle; }
    
    .hdr { font-weight: bold; text-align: center; vertical-align: middle; height: 25px; }
    
    .goods-row td { height: 220px; vertical-align: top; padding: 4px 3px; }
    .desc-h { font-weight: bold; margin-bottom: 3px; font-size: 8px; }
    .desc-ln { margin: 0; line-height: 1.3; }

    .total-label { font-weight: bold; text-align: center; vertical-align: middle; }
    .total-val { font-weight: bold; text-align: right; vertical-align: middle; }

    .amt-words-box { padding: 4px; font-weight: bold; font-size: 7px; vertical-align: top; }
    .amt-words-val { padding: 4px; vertical-align: middle; line-height: 1.4; }

    .weight-label { font-weight: bold; font-size: 7px; text-align: left; vertical-align: middle; }
    .weight-val { font-size: 8px; text-align: center; vertical-align: middle; }

    .bank-box { background-color: #f2f2f2; padding: 4px; border-top: none !important; }
    .bank-label { font-weight: bold; font-size: 7px; margin-bottom: 2px; }
    .bank-val { font-size: 7px; margin-bottom: 1px; }

    .declare-box { padding: 5px; font-size: 6.5px; line-height: 1.3; height: 120px; }
    .declare-h { font-weight: bold; margin-bottom: 2px; font-size: 7px; }
    
    .sign-box { height: 50px; padding: 4px; }
    .sign-h { font-weight: bold; font-size: 7px; text-align: center; border-bottom: 0.5px solid #000; padding-bottom: 2px; }
    
    .no-line-box { line-height: 1.4; }
  </style>
</head>
<body>
<table class="main">
  <colgroup>
    <col class="c1"><col class="c2"><col class="c3">
    <col class="c4"><col class="c5">
    <col class="c6"><col class="c7"><col class="c8">
  </colgroup>

  <!-- TITLE -->
  <tr>
    <td colspan="8" class="title">INVOICE</td>
  </tr>

  <!-- EXPORTER & INVOICE META -->
  <tr>
    <td colspan="3" rowspan="4" style="height:80px;">
      <div class="b">Exporter</div>
      <div class="b">{{exporter.companyName}}</div>
      {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
      <div><span class="b">GST NO-</span> {{exporter.gstin}}</div>
    </td>
    <td colspan="2" class="b">Invoice No &amp; Dt.</td>
    <td colspan="3" class="r">{{invoiceNumber}} Dt.{{invoiceDate}}</td>
  </tr>
  <tr>
    <td colspan="2" class="b">Buyers Order &amp; Dt</td>
    <td colspan="3" class="r">{{buyerOrderDate}}</td>
  </tr>
  <tr>
    <td colspan="2" class="b">Other Reference</td>
    <td colspan="3" class="r">PI No - {{piNumber}} Dt {{piDate}}</td>
  </tr>
  <tr>
    <td colspan="2" class="b">LC No &amp; Dt.</td>
    <td colspan="3" class="l">LC NO - {{lcNumber}} DT {{lcDate}}</td>
  </tr>

  <!-- CONSIGNEE & SCHEME BLOCK -->
  <tr>
    <td colspan="3" rowspan="2" style="height:120px;">
      <div class="b">Consignee</div>
      <div class="b">{{buyerName}}</div>
      {{#each buyerAddressLines}}<div>{{this}}</div>{{/each}}
      <div>{{buyerCountry}}</div>
      <div style="margin-top:10px;">Atte :</div>
      <div>Tel :</div>
    </td>
    <td colspan="5" class="no-line-box" style="height:100px;">
      <div class="b">DRAWBACK SHIPMENT</div>
      <div>RODTEP SCHEME CODE {{scheme.rodtepSchemeCode}}</div>
      <div>END USE CODE- {{scheme.endUseCode}}</div>
      <div>IGST PAYMENT STATUS- {{scheme.igstPaymentStatus}}</div>
      <div>{{scheme.shipmentExportUnderIgstPaid}}</div>
      <div>IEC NO- {{exporter.iecNo}}</div>
      <div style="color:#C00000; font-weight:bold;">AD CODE - {{exporter.adCode}}</div>
      <div>PAN NO- {{exporter.pan}}</div>
    </td>
  </tr>

  <!-- SHIPPING SECTION -->
  <tr>
    <td colspan="5"></td> <!-- spacer -->
  </tr>
  <tr>
    <td colspan="2" class="sh-l">Pre - Carriage by</td>
    <td colspan="1" class="sh-l">Place of Receipt by Pre-Carrier</td>
    <td colspan="2" class="sh-l">Country of Origin of Goods</td>
    <td colspan="3" class="sh-l">Country of Final Destination</td>
  </tr>
  <tr>
    <td colspan="2" class="sh-v">{{preCarriage}}</td>
    <td colspan="1" class="sh-v">{{placeOfReceipt}}</td>
    <td colspan="2" class="sh-v">INDIA</td>
    <td colspan="3" class="sh-v">{{buyerCountry}}</td>
  </tr>
  <tr>
    <td colspan="2" class="sh-l">Vessel/Flight No.</td>
    <td colspan="1" class="sh-l">Port of Loading</td>
    <td colspan="5" class="sh-l">Terms of Delivery and Payment</td>
  </tr>
  <tr>
    <td colspan="2" class="sh-v">{{vesselFlight}}</td>
    <td colspan="1" class="sh-v">{{portOfLoading}}</td>
    <td colspan="5" rowspan="3" style="border-top:none; vertical-align:top; font-weight:bold; padding:4px;">
      {{remarksUSD}}
    </td>
  </tr>
  <tr>
    <td colspan="2" class="sh-l">Port of Discharge</td>
    <td colspan="1" class="sh-l">Final Destination</td>
  </tr>
  <tr>
    <td colspan="2" class="sh-v">{{portOfDischarge}}</td>
    <td colspan="1" class="sh-v">{{placeOfDelivery}}</td>
  </tr>

  <!-- COLUMN HEADERS -->
  <tr>
    <td class="hdr">Marks &amp; Nos<br>Container No</td>
    <td class="hdr">No &amp; Kind<br>of Pkgs</td>
    <td class="hdr">Description of Goods</td>
    <td class="hdr" colspan="2">Quantity<br>In Nos</td>
    <td class="hdr">Rate<br>DDU<br>BY SEA</td>
    <td class="hdr">Amount<br>In USD</td>
    <td class="hdr">RMKS<br>(IF ANY)</td>
  </tr>

  <!-- GOODS ROW -->
  <tr class="goods-row">
    <td>
      {{buyerCity}}<br>
      {{buyerCountry}}<br>
      <br><br>
      {{#if containerNo}}{{containerNo}}{{/if}}
    </td>
    <td class="c">
      Sr no<br><br>{{vehicle.srNo}}
    </td>
    <td>
      {{#each descriptionLines}}
        {{#if @first}}<div class="desc-h">{{this}}</div>
        {{else}}<div class="desc-ln">{{this}}</div>{{/if}}
      {{/each}}
    </td>
    <td class="c" colspan="2">
      {{vehicle.quantity}}<br>Pcs
    </td>
    <td class="r">${{values.totalUSD}}</td>
    <td class="r">${{values.totalUSD}}</td>
    <td class="c">{{vesselFlight}}</td>
  </tr>

  <!-- TOTALS ROW -->
  <tr>
    <td colspan="2" class="total-label">Total No of Cartons / Nos</td>
    <td colspan="3" class="c">{{vehicle.quantity}} Nos</td>
    <td colspan="2" class="total-label">Total</td>
    <td class="total-val r b">${{values.totalUSD}}</td>
  </tr>

  <!-- WEIGHTS ROW -->
  <tr>
    <td colspan="2" class="weight-label">Total Net.Wt.</td>
    <td colspan="1" class="weight-val">{{totalNetWeight}} K.G.</td>
    <td colspan="2" class="weight-label">Total Gross.Wt.</td>
    <td colspan="3" class="weight-val">{{totalGrossWeight}} K.G.</td>
  </tr>

  <!-- AMOUNT IN WORDS ROW -->
  <tr>
    <td colspan="2" class="amt-words-box">Amount Chargeable (In Words)</td>
    <td colspan="6" class="amt-words-val">{{amountWordsUSD}}</td>
  </tr>

  <!-- FINAL BLOCK: DECLARATION (3/4) | SIGN & BANK (1/4) -->
  <tr>
    <td colspan="6" rowspan="2" class="declare-box">
      <div class="declare-h">Declaration</div>
      <div>DBK001- "{{staticText.DBK001}}"</div>
      <div>DBK003- "{{staticText.DBK003}}"</div>
      <div>{{staticText.DECLARATION}}</div>
      <div>{{staticText.MEIS}}</div>
      <div class="declare-h" style="margin-top:5px;">STATEMENT ON ORIGIN</div>
      <div style="text-transform: uppercase;">{{staticText.GSP_ORIGIN}}</div>
    </td>
    <td colspan="2" class="sign-box">
      <div class="sign-h">Sign &amp; Date</div>
    </td>
  </tr>
  <tr>
    <td colspan="2" class="bank-box">
      <div class="bank-label">BANK DETAILS</div>
      <div class="bank-val">NAME: {{exporter.bankName}}</div>
      <div class="bank-val">A/C: {{exporter.accountNo}}</div>
      <div class="bank-val">IFSC: {{exporter.ifsc}}</div>
      <div class="bank-val">SWIFT: {{exporter.swift}}</div>
    </td>
  </tr>

</table>
</body>
</html>
