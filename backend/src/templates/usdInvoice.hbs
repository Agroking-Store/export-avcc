<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>USD Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 10mm 12mm; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.7px; line-height: 1.06; color: #000; margin: 0; }
    * { box-sizing: border-box; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { border: 0.5px solid #000; padding: 1.6px 2.4px; vertical-align: top; }
    .title { font-size: 8.7px; font-weight: 700; text-align: center; }
    .right { text-align: right; }
    .center { text-align: center; }
    .tiny { font-size: 6.9px; }
    .min { font-size: 6.6px; }
    .desc div { margin-bottom: 1.6px; }
    .bank-grid td { height: 16px; }
    .no-break { break-inside: avoid; page-break-inside: avoid; }
  </style>
</head>
<body>
  <table>
    <colgroup>
      <col style="width:15%">
      <col style="width:10%">
      <col style="width:35%">
      <col style="width:10%">
      <col style="width:15%">
      <col style="width:15%">
    </colgroup>
    <tr>
      <td colspan="6" class="title">INVOICE <span style="float:right;">Page - I</span></td>
    </tr>
    <tr>
      <td colspan="3" rowspan="6">
        <div class="bold">Exporter</div>
        <div class="bold" style="font-size:10px;">{{exporter.companyName}}</div>
        {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
        <div>GST NO- {{exporter.gstin}}</div>
      </td>
      <td colspan="3">Invoice No &amp; Dt. <span style="float:right;">{{invoiceNumber}} Dtd. {{invoiceDate}}</span></td>
    </tr>
    <tr>
      <td colspan="3">Buyer's Order &amp; Dt. <span style="float:right;">{{buyerOrderDate}}</span></td>
    </tr>
    <tr>
      <td colspan="3">Other Reference(s) <span style="float:right;">PI No - {{piNumber}} Dtd {{piDate}}</span></td>
    </tr>
    <tr>
      <td colspan="3">LC NO - {{lcNumber}} Dtd {{lcDate}}</td>
    </tr>
    <tr>
      <td colspan="3"></td>
    </tr>
    <tr>
      <td colspan="3"></td>
    </tr>

    <tr>
      <td colspan="3" rowspan="6">
        <div class="bold">Consignee</div>
        <div class="bold">{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
      </td>
      <td colspan="3">DRAWBACK SHIPMENT</td>
    </tr>
    <tr>
      <td colspan="3">RODTEP SCHEME CODE {{scheme.rodtepSchemeCode}}</td>
    </tr>
    <tr>
      <td colspan="3">END USE CODE- {{scheme.endUseCode}}</td>
    </tr>
    <tr>
      <td colspan="3">IGST PAYMENT STATUS- YES</td>
    </tr>
    <tr>
      <td colspan="3">SHIPMENT EXPORT UNDER IGST PAID</td>
    </tr>
    <tr>
      <td colspan="3">
        <div>IEC NO- {{exporter.iecNo}}</div>
        <div style="color:red; font-weight:bold;">AD CODE - {{exporter.adCode}}</div>
      </td>
    </tr>

    <tr>
      <td>Pre-Carriage by</td>
      <td>{{preCarriage}}</td>
      <td>Place of Receipt</td>
      <td colspan="3">{{placeOfReceipt}}</td>
    </tr>
    <tr>
      <td>Vessel/Flight No.</td>
      <td>{{vesselFlight}}</td>
      <td>Port of Loading</td>
      <td colspan="3">{{portOfLoading}}</td>
    </tr>
    <tr>
      <td>Port of Discharge</td>
      <td>{{portOfDischarge}}</td>
      <td>Final Destination</td>
      <td colspan="3">{{placeOfDelivery}}</td>
    </tr>
    <tr>
      <td colspan="3"></td>
      <td colspan="3">State of Origin of Goods - {{stateOfOrigin}}</td>
    </tr>
    <tr>
      <td colspan="3"></td>
      <td colspan="3">District of Origin of Goods - {{districtOfOrigin}}</td>
    </tr>

    <tr>
      <td class="center bold">Marks &amp; Nos. /<br>Container No.</td>
      <td class="center bold">No &amp; Kind<br>of Pkgs</td>
      <td class="center bold">Description of Goods</td>
      <td class="center bold">Quantity<br>In Nos</td>
      <td class="center bold">Rate<br>DDU USD</td>
      <td class="center bold">Amount<br>In USD</td>
    </tr>

    <tr class="no-break" style="min-height: 250px;">
      <td style="vertical-align: top;">
        {{containerNo}}<br><br>
        {{placeOfDelivery}}
      </td>
      <td class="center" style="vertical-align: top;">
        {{totalQty}}<br>Cartons
      </td>
      <td style="vertical-align: top;">
        {{#each descriptionLines}}
          <div style="margin-bottom: 2px;">{{this}}</div>
        {{/each}}
      </td>
      <td class="center" style="vertical-align: top;">
        {{totalQty}}<br>Pcs
      </td>
      <td class="right" style="vertical-align: top;">
        ${{values.totalUSD}}
      </td>
      <td class="right" style="vertical-align: top;">
        ${{values.totalUSD}}
      </td>
    </tr>

    <tr>
      <td colspan="2" class="center bold">Total No of Cartons</td>
      <td colspan="2" class="center bold">Amount Chargeable (In Words)</td>
      <td class="center bold">Total</td>
      <td class="right bold">${{values.totalUSD}}</td>
    </tr>
    <tr>
      <td colspan="2" class="center">{{totalQty}} Nos</td>
      <td colspan="2" class="center bold" style="font-size: 8px;">{{amountWordsUSD}}</td>
      <td colspan="2"></td>
    </tr>

    <tr>
      <td colspan="2" class="center">Total Net.Wt.</td>
      <td colspan="4" rowspan="6">
        <div class="bold">Declaration</div>
        <div class="min">DBK001- "{{staticText.DBK001}}"</div>
        <div class="min">DBK003- "{{staticText.DBK003}}"</div>
        <div class="min">{{staticText.DECLARATION}}</div>
        <div class="min">{{staticText.MEIS}}</div>
        <div class="min">STATEMENT ON ORIGIN</div>
        <div class="min">{{staticText.GSP_ORIGIN}}</div>
      </td>
    </tr>
    <tr>
      <td colspan="2" class="center">{{vehicle.netWeightKg}} K.G.</td>
    </tr>
    <tr>
      <td colspan="2" class="center">Total Gross.Wt.</td>
    </tr>
    <tr>
      <td colspan="2" class="center">{{vehicle.grossWeightKg}} K.G.</td>
    </tr>
    <tr>
      <td colspan="2" rowspan="2">
        <div class="center bold" style="margin-top: 10px;">For {{exporter.companyName}}</div>
        <br><br>
        <div class="center bold">Authorised Signatory</div>
      </td>
    </tr>
    <tr></tr>

    <tr class="bank-grid">
      <td colspan="3"></td>
      <td colspan="1" class="bold">BANK DETAILS</td>
      <td colspan="2">NAME - {{exporter.bankName}}</td>
    </tr>
    <tr class="bank-grid">
      <td colspan="3"></td>
      <td colspan="1"></td>
      <td colspan="2">ACCOUNT NO - {{exporter.accountNo}}</td>
    </tr>
    <tr class="bank-grid">
      <td colspan="3"></td>
      <td colspan="1"></td>
      <td colspan="2">IFSC Code -{{exporter.ifsc}}</td>
    </tr>
    <tr class="bank-grid">
      <td colspan="3"></td>
      <td colspan="1"></td>
      <td colspan="2">SWIFT code: {{exporter.swift}}</td>
    </tr>
  </table>
</body>
</html>
