<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>USD Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 10mm 12mm; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.45px; line-height: 1.08; color: #000; margin: 0; }
    * { box-sizing: border-box; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { border: 0.5px solid #000; padding: 1.5px 2.2px; vertical-align: top; font-weight: 400; }
    .title { font-size: 8.8px; font-weight: 700; text-align: center; }
    .page { float: right; font-weight: 700; }
    .section { font-weight: 700; }
    .company { font-weight: 700; }
    .center { text-align: center; }
    .right { text-align: right; }
    .small { font-size: 6.85px; line-height: 1.08; }
    .goods-cell { height: 146px; }
    .desc-line { margin: 0 0 2px; }
    .sign-box { height: 42px; }
    .bank-row { height: 18px; }
  </style>
</head>
<body>
  <table>
    <colgroup>
      <col style="width:16%">
      <col style="width:9%">
      <col style="width:28%">
      <col style="width:10%">
      <col style="width:11%">
      <col style="width:13%">
      <col style="width:13%">
    </colgroup>

    <tr>
      <td colspan="7" class="title">INVOICE <span class="page">Page - I</span></td>
    </tr>

    <tr>
      <td colspan="3" rowspan="5">
        <div class="section">Exporter</div>
        <div class="company">{{exporter.companyName}}</div>
        {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
        <div>{{exporter.stateCode}}</div>
        <div>GST NO- {{exporter.gstin}}</div>
      </td>
      <td colspan="4">Invoice No &amp; Dt. <span style="float:right;">{{invoiceNumber}} Dt.{{invoiceDate}}</span></td>
    </tr>
    <tr>
      <td colspan="4">Buyers Order &amp; Dt <span style="float:right;">{{buyerOrderDate}}</span></td>
    </tr>
    <tr>
      <td colspan="4">Other Reference <span style="float:right;">PI No - {{piNumber}} Dt {{piDate}}</span></td>
    </tr>
    <tr>
      <td colspan="4">LC NO - {{lcNumber}} DT {{lcDate}}</td>
    </tr>
    <tr>
      <td colspan="4"></td>
    </tr>

    <tr>
      <td colspan="3" rowspan="6">
        <div class="section">Consignee</div>
        <div class="company">{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
      </td>
      <td colspan="4">DRAWBACK SHIPMENT</td>
    </tr>
    <tr>
      <td colspan="4">RODTEP SCHEME CODE {{scheme.rodtepSchemeCode}}</td>
    </tr>
    <tr>
      <td colspan="4">END USE CODE- {{scheme.endUseCode}}</td>
    </tr>
    <tr>
      <td colspan="4">IGST PAYMENT STATUS- {{scheme.igstPaymentStatus}}</td>
    </tr>
    <tr>
      <td colspan="4">{{scheme.shipmentExportUnderIgstPaid}}</td>
    </tr>
    <tr>
      <td colspan="4">
        <div>IEC NO- {{exporter.iecNo}}</div>
        <div>AD CODE - {{exporter.adCode}}</div>
      </td>
    </tr>

    <tr>
      <td>Pre -<br>Carriage</td>
      <td>{{preCarriage}}</td>
      <td>Place of Rcpt by Pre Carrier</td>
      <td>{{placeOfReceipt}}</td>
      <td>Country of Origin</td>
      <td>INDIA</td>
      <td>Country of Destination<br>{{buyerCountry}}</td>
    </tr>
    <tr>
      <td>Vessel/<br>Flight</td>
      <td>{{vesselFlight}}</td>
      <td>Port of Loading</td>
      <td>{{portOfLoading}}</td>
      <td>Terms of Delivery and Payment</td>
      <td colspan="2">{{remarksUSD}}</td>
    </tr>
    <tr>
      <td>Port of Discharge</td>
      <td>{{portOfDischarge}}</td>
      <td>Place of Delivery</td>
      <td>{{placeOfDelivery}}</td>
      <td colspan="3">State of Origin of Goods - {{stateOfOrigin}}</td>
    </tr>
    <tr>
      <td colspan="4"></td>
      <td colspan="3">District of Origin of Goods - {{districtOfOrigin}}</td>
    </tr>

    <tr>
      <td class="center section">Marks &amp; Nos<br>Container No</td>
      <td class="center section">No &amp; Kind<br>of Pkgs</td>
      <td class="center section">Description of Goods</td>
      <td class="center section">Quantity<br>In Nos</td>
      <td class="center section">Rate<br>DDU</td>
      <td class="center section">Amount<br>In USD</td>
      <td class="center section">RMKS<br>(IF ANY)</td>
    </tr>

    <tr>
      <td class="goods-cell">
        {{buyerCountry}}<br>
        {{placeOfDelivery}}<br><br>
        {{#if containerNo}}{{containerNo}}{{/if}}
      </td>
      <td class="goods-cell center">
        Sr no<br><br>
        1
      </td>
      <td class="goods-cell">
        {{#each descriptionLines}}
          <div class="desc-line">{{this}}</div>
        {{/each}}
      </td>
      <td class="goods-cell center">
        1<br><br>
        {{totalQty}}<br>
        Pcs
      </td>
      <td class="goods-cell right">${{values.totalUSD}}</td>
      <td class="goods-cell right">${{values.totalUSD}}</td>
      <td class="goods-cell center">{{vesselFlight}}</td>
    </tr>

    <tr>
      <td colspan="2" class="center">Total No of Cartons</td>
      <td colspan="3">Amount Chargeable (In Words)</td>
      <td class="center">Total</td>
      <td class="right">${{values.totalUSD}}</td>
    </tr>
    <tr>
      <td colspan="2" class="center">{{totalQty}} Nos</td>
      <td colspan="3">{{amountWordsUSD}}</td>
      <td colspan="2"></td>
    </tr>

    <tr>
      <td colspan="2" class="center">Total Net.Wt.</td>
      <td colspan="3" rowspan="9" class="small">
        <div class="section">Declaration</div>
        <div>DBK001 - "{{staticText.DBK001}}"</div>
        <div style="margin-top:4px;">DBK003 - "{{staticText.DBK003}}"</div>
        <div style="margin-top:4px;">{{staticText.DECLARATION}}</div>
        <div style="margin-top:4px;">{{staticText.MEIS}}</div>
        <div style="margin-top:4px;">STATEMENT ON ORIGIN</div>
        <div style="margin-top:4px;">{{staticText.GSP_ORIGIN}}</div>
      </td>
      <td colspan="2" class="center">Sign &amp; Date</td>
    </tr>
    <tr>
      <td colspan="2" class="center">{{vehicle.netWeightKg}} K.G.</td>
      <td colspan="2" rowspan="2" class="sign-box"></td>
    </tr>
    <tr>
      <td colspan="2" class="center">Total Gross.Wt.</td>
    </tr>
    <tr>
      <td colspan="2" class="center">{{vehicle.grossWeightKg}} K.G.</td>
      <td colspan="2" class="section">BANK DETAILS</td>
    </tr>
    <tr class="bank-row">
      <td colspan="2"></td>
      <td colspan="2">NAME - {{exporter.bankName}}</td>
    </tr>
    <tr class="bank-row">
      <td colspan="2"></td>
      <td colspan="2">ACCOUNT NO - {{exporter.accountNo}}</td>
    </tr>
    <tr class="bank-row">
      <td colspan="2"></td>
      <td colspan="2">IFSC Code -{{exporter.ifsc}}</td>
    </tr>
    <tr class="bank-row">
      <td colspan="2"></td>
      <td colspan="2">SWIFT code: {{exporter.swift}}</td>
    </tr>
    <tr>
      <td colspan="2"></td>
      <td colspan="2"></td>
    </tr>
  </table>
</body>
</html>
