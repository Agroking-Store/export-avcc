<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Commercial Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 10mm 12mm; }
    html, body { margin: 0; padding: 0; background: #fff; }
    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 9.4px;
      line-height: 1.28;
      color: #000;
    }
    * { box-sizing: border-box; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th {
      border: 0.7px solid #000;
      padding: 4px 5px;
      vertical-align: top;
      font-weight: 400;
      word-break: break-word;
    }
    .invoice { min-height: 205mm; }
    .title {
      font-size: 14px;
      line-height: 1.2;
      font-weight: 700;
      text-align: center;
      letter-spacing: 0;
      padding: 6px 0;
    }
    .label { font-weight: 700; }
    .company { font-weight: 700; font-size: 10px; }
    .center { text-align: center; }
    .right { text-align: right; }
    .nowrap { white-space: nowrap; }
    .muted-label { font-size: 8.6px; font-weight: 700; }
    .header-cell { min-height: 16mm; }
    .party-cell { height: 30mm; }
    .terms-cell { height: 30mm; }
    .goods-head td { text-align: center; font-weight: 700; vertical-align: middle; height: 10mm; }
    .goods-cell { height: 70mm; }
    .desc-line { margin: 0 0 3px; }
    .desc-line:first-child { font-weight: 700; margin-bottom: 5px; }
    .clause-cell { height: 42mm; padding: 6px 8px; line-height: 1.32; }
    .clause-line { margin: 0 0 4px; }
    .amount-row td { height: 11mm; vertical-align: middle; }
    .sign-row td { height: 24mm; vertical-align: bottom; }
    .small { font-size: 8px; line-height: 1.2; }
  </style>
</head>
<body>
  <table class="invoice">
    <colgroup>
      <col style="width:6%">
      <col style="width:45%">
      <col style="width:13%">
      <col style="width:12%">
      <col style="width:12%">
      <col style="width:5%">
      <col style="width:7%">
    </colgroup>

    <tr>
      <td colspan="7" class="title">COMMERCIAL INVOICE</td>
    </tr>

    <tr>
      <td colspan="2" rowspan="5" class="header-cell">
        <div class="label">Exporter</div>
        <div class="company">{{exporter.companyName}}</div>
        {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
        <div><span class="label">GSTIN/UIN:</span> {{exporter.gstin}}</div>
        <div>State Name : Maharashtra, Code : 27</div>
      </td>
      <td colspan="2" class="muted-label">INVOICE NO</td>
      <td colspan="3" class="muted-label">Dated</td>
    </tr>
    <tr>
      <td colspan="2" class="label">{{invoiceNumber}}</td>
      <td colspan="3" class="label">{{invoiceDate}}</td>
    </tr>
    <tr>
      <td colspan="2" class="muted-label">Buyer's Ref./Order No.</td>
      <td colspan="3" class="muted-label">Other References</td>
    </tr>
    <tr>
      <td colspan="2">{{buyerOrderDate}}</td>
      <td colspan="3">LC NO :-{{lcNumber}} Dt {{lcDate}}</td>
    </tr>
    <tr>
      <td colspan="2">
        <div class="muted-label">Dispatched through</div>
        <div class="label">{{dispatchedThrough}}</div>
      </td>
      <td colspan="3">
        <div class="muted-label">Destination</div>
        <div class="label">{{destination}}</div>
      </td>
    </tr>

    <tr>
      <td colspan="2" class="party-cell">
        <div class="label">Consignee (Ship to)</div>
        <div class="label" style="margin-top:3px;">{{commercialConsignee.name}}</div>
        <div>{{commercialConsignee.addressLine1}}</div>
        <div>{{commercialConsignee.addressLine2}}</div>
      </td>
      <td colspan="5" class="terms-cell">
        <div class="label">Terms of Delivery</div>
        <div>1) Delivery Term: {{scheme.termsOfDelivery}}</div>
        <div>2) Port of Loading: {{portOfLoading}}, India</div>
        <div>3) Port of Discharge: {{portOfDischarge}}, {{buyerCountry}}</div>
      </td>
    </tr>

    <tr>
      <td colspan="2" class="party-cell">
        <div class="label">Buyer (Bill to)</div>
        <div class="label" style="margin-top:3px;">{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
      </td>
      <td colspan="5"></td>
    </tr>

    <tr class="goods-head">
      <td>Sl<br>No.</td>
      <td>Description of Goods</td>
      <td>HSN/SAC</td>
      <td>FOB</td>
      <td>FREIGHT</td>
      <td>per</td>
      <td>Amount</td>
    </tr>

    <tr>
      <td class="goods-cell center label">1</td>
      <td class="goods-cell">
        {{#each descriptionLines}}
          <div class="desc-line">{{this}}</div>
        {{/each}}
      </td>
      <td class="goods-cell center">{{vehicle.hsnCode}}</td>
      <td class="goods-cell right">{{values.fobUSD}}</td>
      <td class="goods-cell right">{{values.freightUSD}}</td>
      <td class="goods-cell center">No</td>
      <td class="goods-cell right">{{values.totalUSD}}</td>
    </tr>

    <tr>
      <td colspan="7" class="clause-cell">
        {{#if commercialClauseLines}}
          {{#each commercialClauseLines}}<div class="clause-line">{{this}}</div>{{/each}}
        {{else}}
          <div class="clause-line">WE HEREBY CERTIFY THAT THIS SHIPMENT CONFIRMS TO PROFORMA INVOICE NO. {{piNumber}} DT {{piDate}}</div>
          <div class="clause-line">WE HEREBY CONFIRM THAT ALL VEHICLES ON THIS INVOICE HAVE THE FOLLOWING ACCESSORIES INSTALLED</div>
          <div class="clause-line">A) AUTOMATIC TRANSMISSION</div>
          <div class="clause-line">B) ANTI-LOCK BRAKING SYSTEM</div>
          <div class="clause-line">C) DRIVER &amp; FRONT PASSENGER HAVE STANDARD AIRBAGS</div>
          <div class="clause-line">D) DRIVER &amp; FRONT PASSENGER HAVE THREE POINT SEAT BELT &amp; OTHER PASSENGERS HAVE MINIMUM TWO POINT SEAT BELT WHERE APPLICABLE.</div>
          <div class="clause-line">WE HEREBY CONFIRM THAT ALL VEHICLES ON THIS INVOICE ARE NOT MORE THAN 3 YEARS OLD AT THE TIME OF SHIPMENT.</div>
        {{/if}}
      </td>
    </tr>

    <tr class="amount-row">
      <td colspan="6" class="right label">Total</td>
      <td class="right label">${{values.totalUSD}}</td>
    </tr>

    <tr class="amount-row">
      <td colspan="5">
        <div class="muted-label">Amount Chargeable (in words)</div>
        <div class="label">{{amountWordsUSD}}</div>
      </td>
      <td colspan="2" class="right">E. &amp; O.E</td>
    </tr>

    <tr class="sign-row">
      <td colspan="5" class="center label">for {{exporter.companyName}}</td>
      <td colspan="2" class="center label">Authorised Signatory</td>
    </tr>

    <tr>
      <td colspan="7" class="center small">This is a Computer Generated Document</td>
    </tr>
  </table>
</body>
</html>
