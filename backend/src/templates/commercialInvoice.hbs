<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Commercial Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 10mm 12mm; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.55px; line-height: 1.08; color: #000; margin: 0; }
    * { box-sizing: border-box; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { border: 0.5px solid #000; padding: 1.5px 2.2px; vertical-align: top; font-weight: 400; }
    .title { font-size: 8.9px; font-weight: 700; text-align: center; }
    .section { font-weight: 700; }
    .company { font-weight: 700; }
    .center { text-align: center; }
    .right { text-align: right; }
    .small { font-size: 6.95px; line-height: 1.08; }
    .goods-cell { height: 118px; }
    .desc-line { margin: 0 0 2px; }
    .sign-block { height: 36px; vertical-align: bottom; }
  </style>
</head>
<body>
  <table>
    <colgroup>
      <col style="width:5%">
      <col style="width:49%">
      <col style="width:11%">
      <col style="width:11%">
      <col style="width:11%">
      <col style="width:5%">
      <col style="width:8%">
    </colgroup>

    <tr>
      <td colspan="7" class="title">COMMERCIAL INVOICE</td>
    </tr>

    <tr>
      <td colspan="2" rowspan="5">
        <div class="company">{{exporter.companyName}}</div>
        {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
        <div>GSTIN/UIN: {{exporter.gstin}}</div>
        <div>State Name : Maharashtra, Code : 27</div>
      </td>
      <td colspan="2">INVOICE NO</td>
      <td colspan="3">Dated</td>
    </tr>
    <tr>
      <td colspan="2">{{invoiceNumber}}</td>
      <td colspan="3">{{invoiceDate}}</td>
    </tr>
    <tr>
      <td colspan="2">Buyer's Ref./Order No.</td>
      <td colspan="3">Other References</td>
    </tr>
    <tr>
      <td colspan="2"></td>
      <td colspan="3">LC NO :-{{lcNumber}} Dt {{lcDate}}</td>
    </tr>
    <tr>
      <td colspan="2">Dispatched through<br>Country:</td>
      <td colspan="3">Destination<br>{{buyerCountry}}</td>
    </tr>

    <tr>
      <td colspan="2">
        <div class="section">Consignee (Ship to)</div>
        <div>{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
      </td>
      <td colspan="5">
        <div class="section">Terms of Delivery</div>
        <div>1) Delivery Term: {{scheme.termsOfDelivery}}</div>
        <div>2) Port of Loading: {{portOfLoading}}, India</div>
        <div>3) Port of Discharge: {{portOfDischarge}}, {{buyerCountry}}</div>
      </td>
    </tr>

    <tr>
      <td colspan="2">
        <div class="section">Buyer (Bill to)</div>
        <div>{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
      </td>
      <td colspan="5"></td>
    </tr>

    <tr>
      <td class="center section">Sl No.</td>
      <td class="center section">Description of Goods</td>
      <td class="center section">HSN/SAC</td>
      <td class="center section">FOB</td>
      <td class="center section">FREIGHT per</td>
      <td class="center section"></td>
      <td class="center section">Amount</td>
    </tr>

    <tr>
      <td class="goods-cell center">1</td>
      <td class="goods-cell">
        {{#each descriptionLines}}
          <div class="desc-line">{{this}}</div>
        {{/each}}
      </td>
      <td class="goods-cell center">{{vehicle.hsnCode}}</td>
      <td class="goods-cell right">{{values.fobUSD}}</td>
      <td class="goods-cell right">{{values.freightUSD}}</td>
      <td class="goods-cell center">No</td>
      <td class="goods-cell right">{{values.totalUSD}}</td>
    </tr>

    <tr>
      <td colspan="7">
        <div>WE HEREBY CERTIFY THAT THIS SHIPMENT CONFIRMS TO PROFORMA INVOICE NO. {{piNumber}} DT {{piDate}}</div>
        <div style="margin-top:4px;">WE HEREBY CONFIRM THAT ALL VEHICLES ON THIS INVOICE HAVE THE FOLLOWING ACCESSORIES INSTALLED</div>
        <div style="margin-top:4px;">A) AUTOMATIC TRANSMISSION</div>
        <div>B) ANTI-LOCK BRAKING SYSTEM</div>
        <div>C) DRIVER &amp; FRONT PASSENGER HAVE STANDARD AIRBAGS</div>
        <div>D) DRIVER &amp; FRONT PASSENGER HAVE THREE POINT SEAT BELT &amp; OTHER PASSENGERS HAVE MINIMUM TWO POINT SEAT BELT WHERE APPLICABLE.</div>
        <div style="margin-top:4px;">WE HEREBY CONFIRM THAT ALL VEHICLES ON THIS INVOICE ARE NOT MORE THAN 3 YEARS OLD AT THE TIME OF SHIPMENT.</div>
      </td>
    </tr>

    <tr>
      <td colspan="6" class="right">Total</td>
      <td class="right">${{values.totalUSD}}</td>
    </tr>

    <tr>
      <td colspan="5">Amount Chargeable (in words)<br>{{amountWordsUSD}}</td>
      <td colspan="2" class="right">E. &amp; O.E</td>
    </tr>

    <tr>
      <td colspan="5" class="sign-block center">for {{exporter.companyName}}</td>
      <td colspan="2" rowspan="2" class="center sign-block">Authorised Signatory</td>
    </tr>
    <tr>
      <td colspan="5"></td>
    </tr>

    <tr>
      <td colspan="7" class="center small">This is a Computer Generated Document</td>
    </tr>
  </table>
</body>
</html>
