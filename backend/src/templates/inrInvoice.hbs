<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>INR Tax Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 10mm 12mm; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.7px; line-height: 1.05; color: #000; margin: 0; }
    * { box-sizing: border-box; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { border: 0.5px solid #000; padding: 1.6px 2.4px; vertical-align: top; }
    .title { text-align: center; font-size: 8.6px; font-weight: 700; margin-bottom: 4px; }
    .center { text-align: center; }
    .right { text-align: right; }
    .tiny { font-size: 6.8px; }
    .no-break { break-inside: avoid; page-break-inside: avoid; }
    .spacing-row td { height: 15px; }
  </style>
</head>
<body>
  <div class="title">TAX INVOICE</div>

  <table>
    <colgroup>
      <col style="width:18%">
      <col style="width:32%">
      <col style="width:10%">
      <col style="width:12%">
      <col style="width:10%">
      <col style="width:18%">
    </colgroup>
    <tr>
      <td colspan="3" rowspan="6">
        <div class="bold">Exporter</div>
        <div class="bold" style="font-size:10px;">{{exporter.companyName}}</div>
        {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
        <div>State Name: Maharashtra, Code: 27</div>
        <div>GSTIN: {{exporter.gstin}}</div>
      </td>
      <td colspan="3">Invoice No &amp; Dt. <span style="float:right;">{{invoiceNumber}} Dtd. {{invoiceDate}}</span></td>
    </tr>
    <tr>
      <td colspan="3">Buyer's Order &amp; Dt. <span style="float:right;">{{buyerOrderDate}}</span></td>
    </tr>
    <tr>
      <td colspan="3">Other Reference(s) <span style="float:right;">PI No - {{piNumber}} Dtd {{piDate}}</span></td>
    </tr>
    <tr>
      <td colspan="3">LC NO - {{lcNumber}} Dtd {{lcDate}}</td>
    </tr>
    <tr>
      <td colspan="3">Buyer (if other than consignee)</td>
    </tr>
    <tr>
      <td colspan="3"></td>
    </tr>

    <tr>
      <td colspan="3" rowspan="6">
        <div class="bold">Consignee</div>
        <div class="bold">{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
      </td>
      <td colspan="3">Country of Origin: <span style="float:right;">INDIA</span></td>
    </tr>
    <tr>
      <td colspan="3">Country of Destination: <span style="float:right;">{{buyerCountry}}</span></td>
    </tr>
    <tr>
      <td colspan="3">
        <div>DRAWBACK SHIPMENT</div>
        <div>RODTEP SCHEME CODE: {{scheme.rodtepSchemeCode}}</div>
      </td>
    </tr>
    <tr>
      <td colspan="3">
        <div>IEC NO: {{exporter.iecNo}}</div>
        <div>AD CODE: {{exporter.adCode}}</div>
      </td>
    </tr>
    <tr>
      <td colspan="3">PAN NO: {{exporter.pan}}</td>
    </tr>
    <tr>
      <td colspan="3">END USE CODE: {{scheme.endUseCode}}</td>
    </tr>

    <tr>
      <td>Pre-Carriage by</td>
      <td>{{preCarriage}}</td>
      <td>Place of Receipt</td>
      <td colspan="3">{{placeOfReceipt}}</td>
    </tr>
    <tr>
      <td>Vessel/Flight No.</td>
      <td>{{vesselFlight}}</td>
      <td>Port of Loading</td>
      <td colspan="3">{{portOfLoading}}</td>
    </tr>
    <tr>
      <td>Port of Discharge</td>
      <td>{{portOfDischarge}}</td>
      <td>Final Destination</td>
      <td colspan="3">{{placeOfDelivery}}</td>
    </tr>

    <tr>
      <td class="center bold">Marks &amp; Nos. /<br>Container No.</td>
      <td class="center bold">Description of Goods</td>
      <td class="center bold">Quantity</td>
      <td class="center bold">Rate (Rs.)</td>
      <td class="center bold">IGST Rate</td>
      <td class="center bold">Amount (Rs.)</td>
    </tr>

    <tr class="no-break" style="min-height: 200px;">
      <td style="vertical-align: top;">
        {{containerNo}}<br><br>
        {{placeOfDelivery}}
      </td>
      <td style="vertical-align: top;">
        {{#each descriptionLines}}
          <div style="margin-bottom: 2px;">{{this}}</div>
        {{/each}}
      </td>
      <td class="center" style="vertical-align: top;">
        {{totalQty}}<br>PCS
      </td>
      <td class="right" style="vertical-align: top;">
        {{values.exShowroomINR}}
      </td>
      <td class="center" style="vertical-align: top;">
        {{vehicle.igstRate}}%
      </td>
      <td class="right" style="vertical-align: top;">
        {{values.totalINR}}
      </td>
    </tr>

    <tr>
      <td colspan="2">
        <div class="tiny bold">Amount Chargeable (in words)</div>
        <div class="bold">{{amountWordsINR}}</div>
      </td>
      <td colspan="3" class="right bold">Total</td>
      <td class="right bold">{{values.totalINR}}</td>
    </tr>

    <tr>
      <td colspan="6" class="tiny" style="padding: 8px;">
        <div class="bold">Declaration:</div>
        {{staticText.DBK001}}<br>
        {{staticText.DBK003}}<br>
        {{staticText.DECLARATION}}<br>
        {{staticText.MEIS}}
      </td>
    </tr>

    <tr>
      <td colspan="3">
        <div class="bold">Statement on Origin:</div>
        <div class="tiny">{{staticText.GSP_ORIGIN}}</div>
      </td>
      <td colspan="3" class="right" style="vertical-align: bottom; height: 60px;">
        <div>For {{exporter.companyName}}</div>
        <br><br><br>
        <div class="bold">Authorised Signatory</div>
      </td>
    </tr>
  </table>

</body>
</html>
