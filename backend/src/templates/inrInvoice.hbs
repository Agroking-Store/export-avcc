<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>INR Tax Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 10mm 12mm; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.7px; line-height: 1.05; color: #000; margin: 0; }
    * { box-sizing: border-box; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { border: 0.5px solid #000; padding: 1.6px 2.4px; vertical-align: top; }
    .title { text-align: center; font-size: 8.6px; font-weight: 700; margin-bottom: 4px; }
    .center { text-align: center; }
    .right { text-align: right; }
    .tiny { font-size: 6.8px; }
    .no-break { break-inside: avoid; page-break-inside: avoid; }
    .spacing-row td { height: 15px; }
  </style>
</head>
<body>
  <div class="title">TAX INVOICE</div>

  <table>
    <colgroup>
      <col style="width:17%">
      <col style="width:10%">
      <col style="width:24%">
      <col style="width:10%">
      <col style="width:10%">
      <col style="width:10%">
      <col style="width:10%">
      <col style="width:9%">
    </colgroup>
    <tr>
      <td colspan="4" rowspan="6">
        <div>Exporter</div>
        <div>{{exporter.companyName}}</div>
        {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
        <div>{{exporter.stateCode}}</div>
        <div>Maharashtra, India.</div>
        <div>GST NO- {{exporter.gstin}}</div>
      </td>
      <td colspan="4">Tax Invoice No &amp; Dt. <span style="float:right;">{{invoiceNumber}} Dt.{{invoiceDate}}</span></td>
    </tr>
    <tr>
      <td colspan="2">Buyers Order &amp; Dt</td>
      <td colspan="2">{{buyerOrderDate}}</td>
    </tr>
    <tr>
      <td colspan="2">Other Reference</td>
      <td colspan="2">PI No - {{piNumber}} Dt {{piDate}}</td>
    </tr>
    <tr>
      <td colspan="2"></td>
      <td colspan="2">LC NO - {{lcNumber}} DT {{lcDate}}</td>
    </tr>
    <tr>
      <td colspan="2">Buyer if other than Consignee</td>
      <td colspan="2"></td>
    </tr>
    <tr>
      <td colspan="4">EXPORT UNDER DRAWBACK SCHEME .</td>
    </tr>

    <tr>
      <td colspan="4" rowspan="7">
        <div>Consignee</div>
        <div>{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
        <div>Atte :</div>
        <div>Tel :</div>
      </td>
      <td colspan="4">RODTEP Scheme CODE {{scheme.rodtepSchemeCode}}</td>
    </tr>
    <tr>
      <td colspan="4">SUPPLY MEANT FOR EXPORT ON PAYMENT OF IGST</td>
    </tr>
    <tr>
      <td colspan="4">SHIPMENT EXPORT UNDER IGST PAID</td>
    </tr>
    <tr>
      <td colspan="2">IEC NO- {{exporter.iecNo}}</td>
      <td colspan="2">AD CODE - {{exporter.adCode}}</td>
    </tr>
    <tr>
      <td colspan="2">PAN NO-{{exporter.pan}}</td>
      <td colspan="2">END USE CODE- {{scheme.endUseCode}}</td>
    </tr>
    <tr>
      <td colspan="2">GST NO-</td>
      <td colspan="2"></td>
    </tr>
    <tr>
      <td colspan="4">Custom Exchange Rate: US DOLLAR 1 = <span style="float:right;">{{values.customExchangeRate}}</span></td>
    </tr>

    <tr>
      <td>Pre -<br />Carriage</td>
      <td>{{preCarriage}}</td>
      <td>Place of Rcpt by Pre Carrier</td>
      <td>{{placeOfReceipt}}</td>
      <td>Country of Origin</td>
      <td>INDIA</td>
      <td>Country of Destination</td>
      <td>{{buyerCountry}}</td>
    </tr>
    <tr>
      <td>Vessel/<br />Flight</td>
      <td>{{vesselFlight}}</td>
      <td>Port of Loading</td>
      <td>{{portOfLoading}}</td>
      <td colspan="4">Terms of Delivery and Payment</td>
    </tr>
    <tr>
      <td>Port of Discharge</td>
      <td>{{portOfDischarge}}</td>
      <td>Place of Delivery</td>
      <td>{{placeOfDelivery}}</td>
      <td colspan="4">{{scheme.termsOfPayment}}</td>
    </tr>

    <tr>
      <td class="center">Marks &amp; Nos<br />Container No</td>
      <td class="center">SR NO</td>
      <td class="center">Description of Goods</td>
      <td class="center">IGST RATE</td>
      <td class="center">Quantity<br />In Pcs</td>
      <td class="center">Rate<br />In (Rs.)</td>
      <td class="center">Amount<br />In (Rs.)</td>
      <td class="center">IGST<br />Amount (Rs)</td>
    </tr>
    <tr class="no-break spacing-row">
      <td rowspan="8">{{containerNo}}<br /><br />{{placeOfDelivery}}</td>
      <td rowspan="8" class="center">1</td>
      <td rowspan="8">
        {{#each descriptionLines}}<div>{{this}}</div>{{/each}}
      </td>
      <td rowspan="8" class="center">{{vehicle.igstRate}}%</td>
      <td rowspan="8" class="center">{{totalQty}}<br /><br />PCS</td>
      <td rowspan="8" class="right">{{values.exShowroomINR}}</td>
      <td rowspan="8" class="right">{{values.totalINR}}</td>
      <td rowspan="8" class="right">{{values.igstAmountINR}}</td>
    </tr>
    <tr class="spacing-row"></tr>
    <tr class="spacing-row"></tr>
    <tr class="spacing-row"></tr>
    <tr class="spacing-row"></tr>
    <tr class="spacing-row"></tr>
    <tr class="spacing-row"></tr>
    <tr class="spacing-row"></tr>

    <tr>
      <td colspan="2">Amount<br />Chargeable<br />(In Words)</td>
      <td colspan="4">{{amountWordsINR}}</td>
      <td class="right">Total</td>
      <td class="right">{{values.totalINR}}</td>
      <td class="right">{{values.igstAmountINR}}</td>
    </tr>
    <tr>
      <td colspan="8" class="tiny">{{staticText.DECLARATION}} {{staticText.MEIS}}</td>
    </tr>
    <tr>
      <td colspan="4">STATEMENT ON ORIGIN</td>
      <td colspan="4" class="right">For {{exporter.companyName}}</td>
    </tr>
    <tr>
      <td colspan="4" class="tiny">{{staticText.GSP_ORIGIN}}</td>
      <td colspan="4" class="right">Authorized Signatory</td>
    </tr>
  </table>
</body>
</html>
