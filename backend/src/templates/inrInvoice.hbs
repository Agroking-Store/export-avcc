<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>INR Tax Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 8mm 8mm; }
    html, body { margin: 0; padding: 0; background: #fff; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.5px; color: #000; line-height: 1.15; }
    * { box-sizing: border-box; }

    table.main {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      border: 0.5px solid #000;
    }
    table.main td {
      border: 0.5px solid #000;
      padding: 1.5px 3px;
      vertical-align: top;
      word-break: break-word;
    }

    /* 8 Columns Grid */
    col.c1 { width: 14%; } /* Marks */
    col.c2 { width: 5%; }  /* SR NO */
    col.c3 { width: 31%; } /* Description */
    col.c4 { width: 8%; }  /* IGST Rate */
    col.c5 { width: 8%; }  /* Quantity */
    col.c6 { width: 11%; } /* Rate */
    col.c7 { width: 11%; } /* Amount */
    col.c8 { width: 12%; } /* IGST Amount */

    .b { font-weight: bold; }
    .c { text-align: center; }
    .r { text-align: right; }
    .title { text-align: center; font-size: 10px; font-weight: bold; padding: 3px; border-bottom: 0.5px solid #000; }
    .label { font-size: 7.5px; line-height: 1.1; }
    .val { font-size: 7.5px; line-height: 1.1; }
    .party-box { height: 75px; vertical-align: top; }
    .meta-label { font-weight: bold; }
    .meta-val { text-align: right; }
    
    .ship-label { font-size: 7px; font-weight: bold; border-bottom: none !important; }
    .ship-val { font-size: 7px; border-top: none !important; min-height: 12px; }
    
    .hdr { font-weight: bold; text-align: center; vertical-align: middle; height: 25px; background: #fff; }
    
    .goods-row td { height: 220px; vertical-align: top; padding: 4px 3px; }
    .desc-h { font-weight: bold; margin-bottom: 3px; font-size: 8px; }
    .desc-ln { margin: 0; line-height: 1.3; }

    .qty-box { display: flex; flex-direction: column; justify-content: space-between; height: 100%; text-align: center; }
    .qty-top { margin-bottom: auto; }
    .qty-mid { margin: auto 0; }
    .qty-bot { margin-top: auto; border-top: 0.5px solid #000; padding-top: 2px; }

    .amt-words-box { padding: 4px; line-height: 1.4; vertical-align: middle; }
    .total-label { font-weight: bold; text-align: center; vertical-align: middle; }
    .total-val { font-weight: bold; text-align: right; vertical-align: middle; }

    .declare-row td { text-align: center; padding: 5px; font-size: 8px; line-height: 1.4; }
    
    .footer-box { height: 90px; }
    .origin-box { font-size: 6.5px; line-height: 1.25; padding: 4px; }
    .sign-box { display: flex; flex-direction: column; justify-content: space-between; height: 100%; padding: 4px; }
    .sign-for { font-weight: bold; text-align: right; }
    .sign-auth { font-weight: bold; text-align: right; }
  </style>
</head>
<body>
<table class="main">
  <colgroup>
    <col class="c1"><col class="c2"><col class="c3">
    <col class="c4"><col class="c5">
    <col class="c6"><col class="c7"><col class="c8">
  </colgroup>

  <!-- ROW 1: TITLE -->
  <tr>
    <td colspan="8" class="title">TAX INVOICE</td>
  </tr>

  <!-- ROW 2-4: EXPORTER & TOP META -->
  <tr>
    <td colspan="3" rowspan="3" class="party-box">
      <div class="label">Exporter</div>
      <div class="b">{{exporter.companyName}}</div>
      {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
      <div><span class="b">GST NO-</span> {{exporter.gstin}}</div>
    </td>
    <td colspan="2" class="b">Tax Invoice No &amp; Dt.</td>
    <td colspan="3" class="r">{{invoiceNumber}} Dt.{{invoiceDate}}</td>
  </tr>
  <tr>
    <td colspan="2" class="b">Buyers Order &amp; Dt</td>
    <td colspan="3" class="r">PI No - {{piNumber}} Dt {{piDate}}</td>
  </tr>
  <tr>
    <td colspan="2" class="b">Other Reference</td>
    <td colspan="3" class="r">LC NO - {{lcNumber}} DT {{lcDate}}</td>
  </tr>

  <!-- ROW 5-15: CONSIGNEE & RIGHT META -->
  <tr>
    <td colspan="3" rowspan="11" class="party-box">
      <div class="label">Consignee</div>
      <div class="b">{{buyerName}}</div>
      {{#each buyerAddressLines}}<div>{{this}}</div>{{/each}}
      <div>{{buyerCountry}}</div>
      <div>Atte :</div>
      <div>Tel :</div>
    </td>
    <td colspan="5">Buyer if other than Consignee</td>
  </tr>
  <tr><td colspan="5">EXPORT UNDER DRAWBACK SCHEME .</td></tr>
  <tr><td colspan="5">RODTEP Scheme CODE {{scheme.rodtepSchemeCode}}</td></tr>
  <tr><td colspan="5">SUPPLY MEANT FOR EXPORT ON PAYMENT OF IGST</td></tr>
  <tr><td colspan="5">SHIPMENT EXPORT UNDER IGST PAID</td></tr>
  <tr><td colspan="5">IEC NO- {{exporter.iecNo}}</td></tr>
  <tr><td colspan="5">AD CODE - {{exporter.adCode}}</td></tr>
  <tr><td colspan="5">PAN NO- {{exporter.pan}}</td></tr>
  <tr><td colspan="5">END USE CODE- {{scheme.endUseCode}}</td></tr>
  <tr><td colspan="5">GST NO-</td></tr>
  <tr>
    <td colspan="3" style="background:#ffff00; font-weight:bold;">Custom Exchange Rate: US DOLLAR 1 =</td>
    <td colspan="2" class="r b" style="background:#ffff00;">{{values.customExchangeRate}}</td>
  </tr>

  <!-- SHIPPING SECTION -->
  <tr>
    <td class="ship-label">Pre-<br>Carriage</td>
    <td class="ship-label" style="border-left:none;"></td>
    <td class="ship-label">Place of Rcpt by Pre Carrier</td>
    <td colspan="2" class="ship-label">Country of Origin</td>
    <td colspan="3" class="ship-label">Country of Destination</td>
  </tr>
  <tr>
    <td class="ship-val">Carriage</td>
    <td class="ship-val" style="border-left:none; text-align:center;">{{preCarriage}}</td>
    <td class="ship-val">{{placeOfReceipt}}</td>
    <td colspan="2" class="ship-val center">INDIA</td>
    <td colspan="3" class="ship-val center">{{buyerCountry}}</td>
  </tr>
  <tr>
    <td class="ship-label">Vessel/<br>Flight</td>
    <td class="ship-label" style="border-left:none; text-align:center;">{{vesselFlight}}</td>
    <td class="ship-label">Port of Loading</td>
    <td colspan="5" class="ship-label">Terms of Delivery and Payment</td>
  </tr>
  <tr>
    <td class="ship-label" style="border-bottom:0.5px solid #000;"></td>
    <td class="ship-val" style="border-left:none; border-bottom:0.5px solid #000;"></td>
    <td class="ship-val" style="border-bottom:0.5px solid #000;">{{portOfLoading}}</td>
    <td colspan="5" rowspan="3" style="vertical-align:top; border-top:none;">
      <div class="b">{{scheme.termsOfPayment}}</div>
      <div style="margin-top:10px;">30 DAYS</div>
    </td>
  </tr>
  <tr>
    <td colspan="2" class="ship-label">Port of Discharge</td>
    <td class="ship-label">Place of Delivery</td>
  </tr>
  <tr>
    <td colspan="2" class="ship-val">{{portOfDischarge}}</td>
    <td class="ship-val">{{placeOfDelivery}}</td>
  </tr>

  <!-- COLUMN HEADERS -->
  <tr>
    <td class="hdr">Marks &amp; Nos<br>Container No</td>
    <td class="hdr">SR NO</td>
    <td class="hdr">Description of Goods</td>
    <td class="hdr">IGST RATE</td>
    <td class="hdr">Quantity<br>In Pcs</td>
    <td class="hdr">Rate<br>In (Rs.)</td>
    <td class="hdr">Amount<br>In (Rs.)</td>
    <td class="hdr">IGST<br>Amount (Rs)</td>
  </tr>

  <!-- GOODS ROW -->
  <tr class="goods-row">
    <td>
      {{buyerCity}}<br>
      {{buyerCountry}}<br>
      <br><br>
      CARTON<br>
      NOS.
    </td>
    <td class="c">{{vehicle.srNo}}</td>
    <td>
      {{#each descriptionLines}}
        {{#if @first}}<div class="desc-h">{{this}}</div>
        {{else}}<div class="desc-ln">{{this}}</div>{{/if}}
      {{/each}}
    </td>
    <td class="c">{{vehicle.igstRate}}%</td>
    <td>
      <div class="qty-box">
        <div class="qty-top">{{vehicle.quantity}}</div>
        <div class="qty-mid">PCS</div>
        <div class="qty-bot">{{vehicle.quantity}}</div>
      </div>
    </td>
    <td class="r">{{values.exShowroomINR}}</td>
    <td class="r">{{values.exShowroomINR}}</td>
    <td class="r">{{values.igstAmountINR}}</td>
  </tr>

  <!-- TOTALS ROW -->
  <tr>
    <td colspan="5" class="amt-words-box">
      <span class="b">Amount Chargeable (In Words)</span><br>
      Rupees {{amountWordsINR}}
    </td>
    <td class="total-label">Total</td>
    <td class="total-val">{{values.exShowroomINR}}</td>
    <td class="total-val">{{values.igstAmountINR}}</td>
  </tr>

  <!-- SPACER -->
  <tr><td colspan="8" style="height:25px; border-top:none; border-bottom:none;"></td></tr>

  <!-- DECLARATION -->
  <tr class="declare-row">
    <td colspan="8">
      We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct. We intend to claim rewards under Merchandise Exports From India Scheme (MEIS)<br>
      <span class="b">RoDTEP Scheme</span>
    </td>
  </tr>

  <!-- FOOTER -->
  <tr class="footer-box">
    <td colspan="5" class="origin-box">
      <div class="b">STATEMENT ON ORIGIN</div>
      <div>{{staticText.GSP_ORIGIN}}</div>
    </td>
    <td colspan="3">
      <div class="sign-box">
        <div class="sign-for">For {{exporter.companyName}}</div>
        <div class="sign-auth">Authorized Signatory</div>
      </div>
    </td>
  </tr>

</table>
</body>
</html>
