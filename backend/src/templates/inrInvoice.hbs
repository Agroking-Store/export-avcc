<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>INR Tax Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 10mm 12mm; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.45px; line-height: 1.08; color: #000; margin: 0; }
    * { box-sizing: border-box; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { border: 0.5px solid #000; padding: 1.5px 2.2px; vertical-align: top; font-weight: 400; }
    .title { font-size: 8.8px; font-weight: 700; text-align: center; }
    .section { font-weight: 700; }
    .company { font-weight: 700; }
    .center { text-align: center; }
    .right { text-align: right; }
    .small { font-size: 6.85px; line-height: 1.08; }
    .goods-cell { height: 134px; }
    .desc-line { margin: 0 0 2px; }
    .sign-area { height: 58px; vertical-align: bottom; }
  </style>
</head>
<body>
  <table>
    <colgroup>
      <col style="width:11%">
      <col style="width:7%">
      <col style="width:34%">
      <col style="width:8%">
      <col style="width:9%">
      <col style="width:12%">
      <col style="width:11%">
      <col style="width:8%">
    </colgroup>

    <tr>
      <td colspan="8" class="title">TAX INVOICE</td>
    </tr>

    <tr>
      <td colspan="3" rowspan="6">
        <div class="section">Exporter</div>
        <div class="company">{{exporter.companyName}}</div>
        {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
        <div>Maharashtra, India.</div>
        <div>GST NO- {{exporter.gstin}}</div>
      </td>
      <td colspan="5">Tax Invoice No &amp; Dt. <span style="float:right;">{{invoiceNumber}} Dt.{{invoiceDate}}</span></td>
    </tr>
    <tr>
      <td colspan="5">Buyers Order &amp; Dt <span style="float:right;">{{buyerOrderDate}}</span></td>
    </tr>
    <tr>
      <td colspan="5">Other Reference <span style="float:right;">PI No - {{piNumber}} Dt {{piDate}}</span></td>
    </tr>
    <tr>
      <td colspan="5">LC NO - {{lcNumber}} DT {{lcDate}}</td>
    </tr>
    <tr>
      <td colspan="5">Buyer if other than Consignee</td>
    </tr>
    <tr>
      <td colspan="5">EXPORT UNDER DRAWBACK SCHEME .</td>
    </tr>

    <tr>
      <td colspan="3" rowspan="7">
        <div class="section">Consignee</div>
        <div class="company">{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
        <div>Atte :</div>
        <div>Tel :</div>
      </td>
      <td colspan="5">RODTEP Scheme CODE {{scheme.rodtepSchemeCode}}</td>
    </tr>
    <tr>
      <td colspan="5">SUPPLY MEANT FOR EXPORT ON PAYMENT OF IGST</td>
    </tr>
    <tr>
      <td colspan="5">{{scheme.shipmentExportUnderIgstPaid}}</td>
    </tr>
    <tr>
      <td colspan="5">IEC NO- {{exporter.iecNo}}</td>
    </tr>
    <tr>
      <td colspan="5">AD CODE - {{exporter.adCode}}</td>
    </tr>
    <tr>
      <td colspan="5">PAN NO-{{exporter.pan}}</td>
    </tr>
    <tr>
      <td colspan="4">END USE CODE- {{scheme.endUseCode}}</td>
      <td>Custom Exchange Rate: US DOLLAR 1 = {{values.customExchangeRate}}</td>
    </tr>

    <tr>
      <td>Pre -<br>Carriage</td>
      <td>{{preCarriage}}</td>
      <td>Place of Rcpt by Pre Carrier</td>
      <td>{{placeOfReceipt}}</td>
      <td>Country of Origin</td>
      <td>INDIA</td>
      <td colspan="2">Country of Destination<br>{{buyerCountry}}</td>
    </tr>
    <tr>
      <td>Vessel/<br>Flight</td>
      <td>{{vesselFlight}}</td>
      <td>Port of Loading</td>
      <td>{{portOfLoading}}</td>
      <td colspan="4">Terms of Delivery and Payment<br>{{scheme.termsOfPayment}}</td>
    </tr>
    <tr>
      <td>Port of Discharge</td>
      <td>{{portOfDischarge}}</td>
      <td>Place of Delivery</td>
      <td>{{placeOfDelivery}}</td>
      <td colspan="4"></td>
    </tr>

    <tr>
      <td class="center section">Marks &amp; Nos<br>Container No</td>
      <td class="center section">SR NO</td>
      <td class="center section">Description of Goods</td>
      <td class="center section">IGST RATE</td>
      <td class="center section">Quantity<br>In Pcs</td>
      <td class="center section">Rate<br>In (Rs.)</td>
      <td class="center section">Amount<br>In (Rs.)</td>
      <td class="center section">IGST<br>Amount (Rs)</td>
    </tr>

    <tr>
      <td class="goods-cell">
        {{placeOfDelivery}}<br>
        {{buyerCountry}}
      </td>
      <td class="goods-cell center">
        1<br><br>
        CARTON<br>
        NOS.
      </td>
      <td class="goods-cell">
        {{#each descriptionLines}}
          <div class="desc-line">{{this}}</div>
        {{/each}}
      </td>
      <td class="goods-cell center">{{vehicle.igstRate}}%</td>
      <td class="goods-cell center">
        1<br><br>
        {{totalQty}}<br>
        PCS
      </td>
      <td class="goods-cell right">{{values.exShowroomINR}}</td>
      <td class="goods-cell right">{{values.exShowroomINR}}</td>
      <td class="goods-cell right">{{values.igstAmountINR}}</td>
    </tr>

    <tr>
      <td colspan="5">Amount Chargeable (In Words)<br>{{amountWordsINR}}</td>
      <td class="center">Total</td>
      <td class="right">{{values.exShowroomINR}}</td>
      <td class="right">{{values.igstAmountINR}}</td>
    </tr>

    <tr>
      <td colspan="5" class="small">
        {{staticText.DECLARATION}} {{staticText.MEIS}}
      </td>
      <td colspan="3" rowspan="2" class="sign-area center">
        <div>For {{exporter.companyName}}</div>
        <br><br>
        <div>Authorized Signatory</div>
      </td>
    </tr>
    <tr>
      <td colspan="5" class="small">
        <div class="section">STATEMENT ON ORIGIN</div>
        <div>{{staticText.GSP_ORIGIN}}</div>
      </td>
    </tr>
  </table>
</body>
</html>
