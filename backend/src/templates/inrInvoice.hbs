<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>INR Tax Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 8mm 8mm; }
    html, body { margin: 0; padding: 0; background: #fff; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.5px; color: #000; line-height: 1.15; }
    * { box-sizing: border-box; }

    table.main {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      border: 0.5px solid #000;
    }
    table.main td {
      border: 0.5px solid #000;
      padding: 1.5px 3px;
      vertical-align: top;
      word-break: break-word;
    }

    /* 8 Columns Grid */
    col.c1 { width: 14%; }
    col.c2 { width: 8%; }
    col.c3 { width: 28%; }
    col.c4 { width: 8%; }
    col.c5 { width: 8%; }
    col.c6 { width: 11%; }
    col.c7 { width: 11%; }
    col.c8 { width: 12%; }

    .b { font-weight: bold; }
    .c { text-align: center; }
    .r { text-align: right; }
    .title { text-align: center; font-size: 10px; font-weight: bold; padding: 3px; border-bottom: 0.5px solid #000; }
    
    /* Shipping specific */
    .sh-l { font-size: 7px; font-weight: bold; border-bottom: none !important; }
    .sh-v { font-size: 7.5px; border-top: none !important; min-height: 15px; }
    .sh-rs2 { vertical-align: middle; text-align: center; font-weight: normal; }
    .sh-rs2-l { vertical-align: middle; text-align: left; font-weight: bold; font-size: 7px; }

    .hdr { font-weight: bold; text-align: center; vertical-align: middle; height: 25px; }
    
    .goods-row td { height: 250px; vertical-align: top; padding: 4px 3px; }
    .desc-h { font-weight: bold; margin-bottom: 3px; font-size: 8px; }
    .desc-ln { margin: 0; line-height: 1.3; }

    .qty-box { display: flex; flex-direction: column; justify-content: space-between; height: 100%; text-align: center; }
    .qty-top { margin-bottom: auto; }
    .qty-mid { margin: auto 0; }
    .qty-bot { margin-top: auto; border-top: 0.5px solid #000; padding-top: 2px; font-weight: bold; }

    .amt-words-box { padding: 4px; font-weight: bold; font-size: 7px; border-right: none !important; }
    .amt-words-val { padding: 4px; vertical-align: middle; border-left: none !important; }
    
    .total-label { font-weight: bold; text-align: center; vertical-align: middle; }
    .total-val { font-weight: bold; text-align: right; vertical-align: middle; }

    .declare-row td { text-align: center; padding: 4px; font-size: 8px; line-height: 1.4; border-bottom: none; }
    .declare-row-2 td { text-align: center; padding: 2px; font-size: 8px; line-height: 1.4; border-top: none; font-weight: bold; }
    
    .footer-row td { height: 90px; }
    .origin-box { font-size: 6.5px; line-height: 1.25; padding: 4px; vertical-align: top; }
    .sign-box { display: flex; flex-direction: column; justify-content: space-between; height: 100%; padding: 4px; }
    .sign-for { font-weight: bold; text-align: left; }
    .sign-auth { font-weight: bold; text-align: left; margin-top: auto; }

    .no-line-box { line-height: 1.4; }

    /* Exporter address formatting */
    .exporter-address { text-transform: uppercase; }
    .addr-line { margin: 0; line-height: 1.3; }
    .exporter-address .addr-line + .addr-line { margin-top: 0.5px; }

    /* CARTON NOS separator lines */
    .carton-box { text-align: left; }
    .carton-sep { height: 0.5px; background: #000; margin: 1px 0; width: 100%; }
  </style>
</head>
<body>
<table class="main">
  <colgroup>
    <col class="c1"><col class="c2"><col class="c3">
    <col class="c4"><col class="c5">
    <col class="c6"><col class="c7"><col class="c8">
  </colgroup>

  <!-- TITLE -->
  <tr>
    <td colspan="8" class="title">TAX INVOICE</td>
  </tr>

  <!-- EXPORTER & INVOICE META -->
  <tr>
    <td colspan="3" rowspan="3" style="height:80px;">
      <div class="b">Exporter</div>
      <div class="b">{{exporter.companyName}}</div>
      <div class="exporter-address">
        {{#each exporter.addressLines}}<div class="addr-line">{{this}}</div>{{/each}}
      </div>
      <div><span class="b">GST NO-</span> <span class="exporter-address">{{exporter.gstin}}</span></div>
    </td>
    <td colspan="2" class="b">Tax Invoice No &amp; Dt.</td>
    <td colspan="3" class="r">{{invoiceNumber}} Dt.{{invoiceDate}}</td>
  </tr>
  <tr>
    <td colspan="2" class="b">Buyers Order &amp; Dt</td>
    <td colspan="3" class="r">PI No - {{piNumber}} Dt {{piDate}}</td>
  </tr>
  <tr>
    <td colspan="2" class="b">LC No &amp; Dt.</td>
    <td colspan="3" class="r">{{lcNumber}} Dt {{lcDate}}</td>
  </tr>

  <!-- CONSIGNEE & RIGHT BLOCK -->
  <tr>
    <td colspan="3" rowspan="2" style="height:120px;">
      <div class="b">Consignee</div>
      <div style="margin-top:2px;">{{buyerName}}</div>
      {{#if buyerAddressLines}}
        {{#each buyerAddressLines}}
          <div style="margin-top:2px;">{{this}}</div>
        {{/each}}
      {{else}}
        {{buyerAddress}}
      {{/if}}
      <div style="margin-top:2px;">{{buyerCountry}}</div>
      <div style="margin-top:8px;">Atte :</div>
      <div>Tel :</div>
    </td>
    <td colspan="5" class="no-line-box" style="height:100px; border-bottom:none;">
      <div>Buyer if other than Consignee</div>
      <div>EXPORT UNDER DRAWBACK SCHEME .</div>
      <div>RODTEP Scheme CODE {{scheme.rodtepSchemeCode}}</div>
      <div>SUPPLY MEANT FOR EXPORT ON PAYMENT OF IGST</div>
      <div>SHIPMENT EXPORT UNDER IGST PAID</div>
      <div>IEC NO- {{exporter.iecNo}}</div>
      <div>AD CODE - {{exporter.adCode}}</div>
      <div>PAN NO- {{exporter.pan}}</div>
      <div>END USE CODE- {{scheme.endUseCode}}</div>
      <div>GST NO- {{buyerGstin}}</div>
    </td>
  </tr>
  <tr>
    <td colspan="8" style="background:#ffff00; border-top:none; padding:0;">
      <table style="width:100%; border-collapse:collapse; border:none;">
        <tr>
          <td style="border:none; padding:3px; font-weight:bold;">Custom Exchange Rate: US DOLLAR 1 =</td>
          <td style="border:none; padding:3px; text-align:right; font-weight:bold; width:15%;">{{values.customExchangeRate}}</td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- SHIPPING SECTION -->
  <!-- Row 1: Labels -->
  <tr>
    <td rowspan="2" class="sh-rs2-l">Pre-Carriage</td>
    <td rowspan="2" class="sh-rs2">{{preCarriage}}</td>
    <td class="sh-l">Place of Rcpt by Pre Carrier</td>
    <td colspan="2" class="sh-l">Country of Origin</td>
    <td colspan="3" class="sh-l">Country of Destination</td>
  </tr>
  <!-- Row 2: Values -->
  <tr>
    <td class="sh-v">{{placeOfReceipt}}</td>
    <td colspan="2" class="sh-v">INDIA</td>
    <td colspan="3" class="sh-v">{{buyerCountry}}</td>
  </tr>
  <!-- Row 3: Labels -->
  <tr>
    <td rowspan="2" class="sh-rs2-l">Vessel/Flight</td>
    <td rowspan="2" class="sh-rs2">{{vesselFlight}}</td>
    <td class="sh-l">Port of Loading</td>
    <td colspan="5" class="sh-l">Terms of Delivery and Payment</td>
  </tr>
  <!-- Row 4: Values -->
  <tr>
    <td class="sh-v">{{portOfLoading}}</td>
    <td colspan="5" rowspan="3" style="border-top:none; vertical-align:top; font-weight:bold; padding:4px;">
      {{scheme.termsOfPayment}}
    </td>
  </tr>
  <!-- Row 5: Labels -->
  <tr>
    <td colspan="2" class="sh-l">Port of Discharge</td>
    <td class="sh-l">Place of Delivery</td>
  </tr>
  <!-- Row 6: Values -->
  <tr>
    <td colspan="2" class="sh-v">{{portOfDischarge}}</td>
    <td class="sh-v">{{placeOfDelivery}}</td>
  </tr>

  <!-- COLUMN HEADERS -->
  <tr>
    <td class="hdr">Marks &amp; Nos<br>Container No</td>
    <td class="hdr">SR NO</td>
    <td class="hdr">Description of Goods</td>
    <td class="hdr">IGST RATE</td>
    <td class="hdr">Quantity<br>In Pcs</td>
    <td class="hdr">Rate<br>In (Rs.)</td>
    <td class="hdr">Amount<br>In (Rs.)</td>
    <td class="hdr">IGST<br>Amount (Rs)</td>
  </tr>

  <!-- GOODS ROW -->
  <tr class="goods-row">
    <td>
      <div class="carton-box">
        {{buyerCity}}<br>
        {{buyerCountry}}<br>
        <br><br>
        <div class="carton-sep"></div>
        CARTON<br>
        NOS.
        <div class="carton-sep"></div>
      </div>
    </td>
    <td class="c">{{vehicle.srNo}}</td>
    <td>
      {{#each descriptionLines}}
        {{#if @first}}<div class="desc-h">{{this}}</div>
        {{else}}<div class="desc-ln">{{this}}</div>{{/if}}
      {{/each}}
    </td>
    <td class="c">{{vehicle.igstRate}}%</td>
    <td>
      <div class="qty-box">
        <div class="qty-top">{{vehicle.quantity}}</div>
        <div class="qty-mid">PCS</div>
        <div class="qty-bot">{{vehicle.quantity}}</div>
      </div>
    </td>
    <td class="r">{{values.exShowroomINR}}</td>
    <td class="r">{{values.exShowroomINR}}</td>
    <td class="r">{{values.igstAmountINR}}</td>
  </tr>

  <!-- TOTALS ROW -->
  <tr>
    <td colspan="1" class="amt-words-box">
      Amount Chargeable<br>(In Words)
    </td>
    <td colspan="4" class="amt-words-val">
      {{amountWordsINR}}
    </td>
    <td class="total-label">Total</td>
    <td class="total-val">{{values.exShowroomINR}}</td>
    <td class="total-val">{{values.igstAmountINR}}</td>
  </tr>

  <!-- DECLARATION -->
  <tr class="declare-row">
    <td colspan="8">
      We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct. We intend to claim rewards under Merchandise Exports From India Scheme (MEIS)
    </td>
  </tr>
  <tr class="declare-row-2">
    <td colspan="8">RoDTEP Scheme</td>
  </tr>

  <!-- FOOTER -->
  <tr class="footer-row">
    <td colspan="5" class="origin-box">
      <div class="b">STATEMENT ON ORIGIN</div>
      <div style="text-transform: uppercase;">{{staticText.GSP_ORIGIN}}</div>
    </td>
    <td colspan="3">
      <div class="sign-box">
        <div class="sign-for">For {{exporter.companyName}}</div>
        <div class="sign-auth">Authorized Signatory</div>
      </div>
    </td>
  </tr>

</table>
</body>
</html>
