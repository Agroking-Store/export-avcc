<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>INR Tax Invoice</title>
  <style>
    @page { size: A4 portrait; margin: 10mm 12mm; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 7.15px;
      line-height: 1.02;
      color: #000;
    }
    * { box-sizing: border-box; }
    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      border: 1px solid #000;
    }
    td, th {
      border: 0.5px solid #000;
      padding: 1.5px 2px;
      vertical-align: top;
      font-weight: 400;
    }
    .label {
      font-weight: 700 !important;
      padding: 2px 2px 0 !important;
    }
    .ship-label, .section {
      padding: 2px 2px 0;
      font-weight: 700;
    }
    .desc-cell, .goods-cell {
      line-height: 1.15;
    }
    .sign-box {
      text-align: right;
      vertical-align: bottom;
      padding-bottom: 2px;
    }
    .amount-col {
      text-align: right;
    }
    .qty-stack {
      text-align: center;
      line-height: 1.1;
    }
    .title {
      font-size: 8.8px;
      font-weight: 700;
      text-align: center;
      padding: 2px 0 3px;
    }
    .section { font-weight: 700; }
    .company { font-weight: 700; }
    .topbox { line-height: 1.08; }
    .tight { line-height: 1.02; }
    .center { text-align: center; }
    .right { text-align: right; }
    .small { font-size: 6.45px; line-height: 1.03; }
    .tiny { font-size: 6.1px; line-height: 1.02; }
    .header-cell {
      font-weight: 700;
      text-align: center;
      line-height: 1.05;
      padding: 1px 2px;
    }
    .goods-cell {
      height: 133px;
      line-height: 1.02;
    }
    .desc-cell {
      font-size: 6.55px;
      line-height: 1.02;
    }
    .desc-cell div {
      margin: 0;
      padding: 0;
    }
    .ship-label {
      padding: 1px 2px;
      line-height: 1.02;
    }
    .ship-value {
      padding: 1px 2px;
      line-height: 1.02;
    }
    .bold { font-weight: 700; }
    .sign-space { height: 58px; vertical-align: bottom; position: relative; }
    .bank-head { font-weight: 700; }
    .bank-row { height: 17px; }
    .amount-row td {
      font-size: 7.05px;
      line-height: 1.02;
    }
    .label-top-left {
      padding: 0 0 0 1px !important;
      font-weight: 700;
      line-height: 1.0;
      position: relative;
      top: 0;
      left: 0;
    }
    .bank-single {
      border: 0.5px solid #000 !important;
      line-height: 1.08;
      padding: 2px;
    }
    .bank-content {
      vertical-align: top;
      padding-top: 0;
    }
    .desc-spaced {
      line-height: 1.18 !important;
    }
    .sign-bottom-right {
      position: absolute;
      bottom: 2px;
      right: 4px;
      font-weight: 700;
    }
    .total-bold {
      font-weight: 700 !important;
    }
    .qty-tight-center {
      text-align: center;
      line-height: 1.05;
    }
    .terms-same-line {
      display: inline;
      white-space: nowrap;
    }
    .title-bold {
      font-weight: 700 !important;
    }
  </style>
</head>
<body>
  <table>
    <colgroup>
      <col style="width:55px">
      <col style="width:38px">
      <col style="width:140px">
      <col style="width:45px">
      <col style="width:45px">
      <col style="width:65px">
      <col style="width:65px">
      <col style="width:65px">
    </colgroup>

    <tr>
      <td colspan="8" class="title title-bold">TAX INVOICE</td>
    </tr>

    <tr>
      <td colspan="3" rowspan="15" class="topbox" style="border-right: 0.5px solid #000;">
        <div class="label-top-left">Exporter</div>
        <div class="company">{{exporter.companyName}}</div>
        {{#each exporter.addressLines}}<div>{{this}}</div>{{/each}}
        <div>Maharashtra, India.</div>
        <div>GST NO- {{exporter.gstin}}</div>
      </td>
      <td colspan="5" class="topbox"><span class="section">Tax Invoice No &amp; Dt.</span> <span style="float:right;">{{invoiceNumber}} Dt.{{invoiceDate}}</span></td>
    </tr>
    <tr>
      <td colspan="5" class="topbox"><span class="section">Buyers Order &amp; Dt</span> <span style="float:right;">{{buyerOrderDate}}</span></td>
    </tr>
    <tr>
      <td colspan="5" class="topbox"><span class="section">Other Reference</span> <span style="float:right;">PI No - {{piNumber}} Dt {{piDate}}</span></td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">LC NO - {{lcNumber}} DT {{lcDate}}</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">Buyer if other than Consignee</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">EXPORT UNDER DRAWBACK SCHEME .</td>
    </tr>

    <tr>
      <td colspan="3" rowspan="8" class="topbox" style="border-right: 0.5px solid #000;">
        <div class="label-top-left">Consignee</div>
        <div class="company">{{buyerName}}</div>
        <div>{{buyerAddress}}</div>
        <div>{{buyerCountry}}</div>
        <div>Atte :</div>
        <div>Tel :</div>
      </td>
      <td colspan="5" class="topbox">RODTEP Scheme CODE {{scheme.rodtepSchemeCode}}</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">SUPPLY MEANT FOR EXPORT ON PAYMENT OF IGST</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">IGST PAYMENT STATUS- YES</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">SHIPMENT EXPORT UNDER IGST PAID</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">IEC NO- {{exporter.iecNo}}</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">AD CODE - {{exporter.adCode}}</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">PAN NO-{{exporter.pan}}</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">END USE CODE- {{scheme.endUseCode}}</td>
    </tr>
    <tr>
      <td colspan="5" class="topbox">Custom Exchange Rate: US DOLLAR 1 = &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{values.customExchangeRate}}</td>
    </tr>

    <tr>
      <td class="ship-label">Pre -<br>Carriage</td>
      <td class="ship-value">{{preCarriage}}</td>
      <td class="ship-label">Place of Rcpt by Pre Carrier</td>
      <td class="ship-value">{{placeOfReceipt}}</td>
      <td class="ship-label">Country of Origin</td>
      <td class="ship-value center">INDIA</td>
      <td colspan="2" class="ship-label">Country of Destination<br>{{buyerCountry}}</td>
    </tr>
    <tr>
      <td class="ship-label">Vessel/<br>Flight</td>
      <td class="ship-value">{{vesselFlight}}</td>
      <td class="ship-label">Port of Loading</td>
      <td class="ship-value">{{portOfLoading}}</td>
      <td class="ship-label label-top-left">Terms of Delivery and Payment</td>
      <td colspan="3" class="ship-value"><span class="terms-same-line">{{scheme.termsOfPayment}}</span></td>
    </tr>
    <tr>
      <td class="ship-label">Port of Discharge</td>
      <td class="ship-value">{{portOfDischarge}}</td>
      <td class="ship-label">Place of Delivery</td>
      <td class="ship-value">{{placeOfDelivery}}</td>
      <td colspan="4" class="ship-value">State of Origin of Goods - {{stateOfOrigin}}</td>
    </tr>
    <tr>
      <td colspan="4"></td>
      <td colspan="4" class="ship-value">District of Origin of Goods - {{districtOfOrigin}}</td>
    </tr>

    <tr>
      <td class="header-cell">Marks &amp; Nos<br>Container No</td>
      <td class="header-cell">SR NO</td>
      <td class="header-cell">Description of Goods</td>
      <td class="header-cell">IGST RATE</td>
      <td class="header-cell">Quantity<br>In Pcs</td>
      <td class="header-cell">Rate<br>In (Rs.)</td>
      <td class="header-cell">Amount<br>In (Rs.)</td>
      <td class="header-cell">IGST<br>Amount (Rs)</td>
    </tr>

    <tr>
      <td class="goods-cell tight">
        {{placeOfDelivery}}<br>
        {{buyerCountry}}
      </td>
      <td class="goods-cell center tight">
        1<br><br>
        CARTON<br>
        NOS.
      </td>
      <td class="goods-cell desc-cell desc-spaced">
        {{#each descriptionLines}}
          <div>{{this}}</div>
        {{/each}}
      </td>
      <td class="goods-cell center tight">{{vehicle.igstRate}}%</td>
      <td class="goods-cell qty-tight-center">
        1<br>PCS<br>1
      </td>
      <td class="goods-cell right tight">{{values.exShowroomINR}}</td>
      <td class="goods-cell right tight">{{values.exShowroomINR}}</td>
      <td class="goods-cell right tight">{{values.igstAmountINR}}</td>
    </tr>

    <tr class="amount-row">
      <td colspan="5" class="bold">Amount Chargeable (In Words)<br>{{amountWordsINR}}</td>
      <td colspan="2" class="center total-bold">Total</td>
      <td class="right total-bold">{{values.exShowroomINR}}</td>
    </tr>
    <tr>
      <td colspan="6" class="right total-bold" style="border-top: none;"></td>
      <td colspan="2" class="right total-bold">{{values.igstAmountINR}}</td>
    </tr>

    <tr>
      <td colspan="5" rowspan="2" class="small">
        <div class="bold">Declaration</div>
        <div class="tight">{{staticText.DBK001}}</div>
        <div class="tight" style="margin-top:3px;">{{staticText.DBK003}}</div>
        <div class="tight" style="margin-top:3px;">{{staticText.DECLARATION}}</div>
        <div class="tight" style="margin-top:3px;">{{staticText.MEIS}}</div>
        <div class="bold" style="margin-top:3px;">STATEMENT ON ORIGIN</div>
        <div class="tight">{{staticText.GSP_ORIGIN}}</div>
      </td>
      <td colspan="3" class="sign-space right">
        <div style="text-align: right;">For {{exporter.companyName}}</div>
        <div class="sign-bottom-right">Authorized Signatory</div>
      </td>
    </tr>
    <tr>
      <td colspan="3" class="bank-single">
        <div class="label-top-left bold">BANK DETAILS</div>
        <div class="bank-content">NAME - {{exporter.bankName}}<br>ACCOUNT NO - {{exporter.accountNo}}<br>IFSC Code - {{exporter.ifsc}}<br>SWIFT code: {{exporter.swift}}</div>
      </td>
    </tr>
  </table>
</body>
</html>
